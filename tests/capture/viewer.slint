import { ScrollView, Palette } from "std-widgets.slint";
import { CapturePanel, CaptureRow } from "../../src/app/ui/captures.slint";
export { CaptureRow } from "../../src/app/ui/captures.slint";
export { Tr } from "../../src/app/ui/i18n.slint";
export { UiTheme } from "../../src/app/ui/theme.slint";
import { UiTheme } from "../../src/app/ui/theme.slint";
export component CaptureTestWindow inherits Window {
    in property <[CaptureRow]> records;
    in property <bool> selected;
    in property <image> photo;
    init => { Palette.color-scheme = ColorScheme.dark; }
    preferred-width: UiTheme.window-width;
    preferred-height: UiTheme.window-height * 1.5;
    background: UiTheme.canvas;
    ScrollView {
        content-width: self.width;
        VerticalLayout {
            padding: UiTheme.s8;
            alignment: start;
            CapturePanel {
                records: root.records;
                selected: root.selected;
                selected-image: root.photo;
            }
        }
    }
}
