[Unit]
Description=Smile2Unlock system authentication service
After=systemd-udev-settle.service
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/libexec/smile2unlock/su_authd
Restart=on-failure
RestartSec=1s
RuntimeDirectory=smile2unlock
RuntimeDirectoryMode=0755
Environment=SU_SEETAFACE_MODEL_DIR=/usr/share/smile2unlock/models
Environment=LD_LIBRARY_PATH=/usr/lib/smile2unlock
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-video4linux rw
CapabilityBoundingSet=CAP_SETUID
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
