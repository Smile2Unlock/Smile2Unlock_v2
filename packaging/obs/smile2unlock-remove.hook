[Trigger]
Operation = Remove
Type = Package
Target = smile2unlock

[Action]
Description = Roll back Smile2Unlock authentication integration
When = PreTransaction
Exec = /bin/sh -ec '/usr/libexec/smile2unlock/su_deploy_helper --rollback-all; systemctl disable --now su-authd.service >/dev/null 2>&1 || true; if [ -d /var/lib/smile2unlock/users ]; then find /var/lib/smile2unlock/users -mindepth 2 -maxdepth 2 -type f -name authtok.s2u -delete; fi; /usr/libexec/smile2unlock/manage-selinux-policy remove'
AbortOnFail
