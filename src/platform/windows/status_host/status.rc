#include <windows.h>
#include "su_version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION SU_VERSION_NUMERIC
 PRODUCTVERSION SU_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Smile2Unlock"
   VALUE "FileDescription", "Smile2Unlock recognition status"
   VALUE "FileVersion", SU_VERSION_STR
   VALUE "ProductName", "Smile2Unlock"
   VALUE "ProductVersion", SU_VERSION_STR
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
