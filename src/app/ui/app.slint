import { ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, Switch } from "std-widgets.slint";
export { UiTheme } from "theme.slint";
export { ProfileRow } from "components.slint";
export { DeploymentTargetRow } from "deployment.slint";
import { UiTheme } from "theme.slint";
import { DeploymentPanel, DeploymentTargetRow } from "deployment.slint";
import {
    ActionButton, CenteredActionButton, CenteredStatusPill, DiagnosticRow,
    MetricBlock, NavButton, PageHeader, ProfileRow, SectionTitle,
    SegmentedSelector, SetupStep, StatusPill,
} from "components.slint";

export component AppWindow inherits Window {
    in property <string> title_text: "Smile2Unlock";
    in property <string> username: "";
    in property <string> username_initial: "U";
    in property <string> core_version: "";
    in property <string> config_path_text: "";
    in property <string> profile_store_path_text: "";
    in property <string> camera_text: "";
    in property <int> camera_count: 0;
    in property <bool> seetaface_available: false;
    in property <bool> service_available: false;
    in property <int> storage_protection_index: 0;
    in property <bool> pam_status_known: false;
    in property <bool> pam_configured: false;
    in property <string> pam_service: "";
    in property <bool> deployment_helper_available: false;
    in property <bool> deployment_installer_available: false;
    in property <bool> login_pam_configured: false;
    in property <bool> lock_pam_configured: false;
    in property <[DeploymentTargetRow]> deployment_targets;
    in-out property <string> deployment_operation_status: "";
    in-out property <bool> desktop_auth_passed: false;
    in property <[ProfileRow]> profiles;
    in property <[string]> camera_options;
    in property <[string]> language_names;

    in property <image> preview_image;
    in property <float> face_box_x;
    in property <float> face_box_y;
    in property <float> face_box_w;
    in property <float> face_box_h;
    in property <bool> face_box_visible: false;
    in property <int> preview_source_width;
    in property <int> preview_source_height;
    in-out property <string> preview_status_text: "";

    in-out property <int> current_page: 0;
    in-out property <int> language_index: 0;
    in-out property <int> theme_mode_index: 0;
    in-out property <int> window_controls_index: 0;
    in property <bool> window_frame_visible: true;
    in-out property <string> enroll_label_text: "";
    in-out property <string> activity_title: "";
    in-out property <string> activity_detail: "";
    in-out property <string> activity_tone: "neutral";
    in-out property <bool> busy: false;
    in-out property <int> selected_camera: 0;
    in-out property <float> recognition_threshold: 0.65;
    in-out property <bool> liveness_enabled: true;
    in-out property <float> liveness_threshold: 0.5;
    in-out property <int> preview_fps: 15;
    in-out property <string> settings_status: "";
    // Recognition trigger policy (Windows only; hidden on Linux).
    in property <bool> platform_windows: false;
    in-out property <int> recognition_mode: 0;
    in-out property <int> auto_delay_sec: 3;
    in-out property <int> retry_delay_sec: 5;
    in-out property <int> timeout_sec: 30;

    callback enroll_current_frame_requested(string);
    callback current_frame_auth_requested();
    callback delete_profile_requested(string);
    callback refresh_profiles_requested();
    callback refresh_system_status_requested();
    callback install_deployment_helper_requested();
    callback initialize_system_deployment_requested();
    callback configure_desktop_target_requested(string, bool);
    callback rollback_desktop_target_requested(string);
    callback start_preview_requested();
    callback stop_preview_requested();
    callback save_settings_requested(int, float, bool, float, int, int, int, int, int);
    callback language_selected(int);
    callback theme_mode_selected(int);
    callback window_controls_selected(int);
    pure callback translate(string, int) -> string;
    pure callback translate_value(string, int, string) -> string;

    private property <bool> dark-mode: UiTheme.dark-mode;

    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    title: title_text;
    // Application icon (embedded at compile time).
    icon: @image-url("../../../common/resources/img/Smile2Unlock.png");
    no-frame: !root.window_frame_visible;
    // No explicit width/height: an explicit size would bind the window to
    // that size (update_window_properties re-applies it, making the window
    // non-resizable and oversized on small screens). The initial size is
    // chosen by su_app at startup to fit the desktop; preferred-* only
    // guides the layout.
    preferred-width: 1560px;
    preferred-height: 880px;
    background: UiTheme.canvas;

    private property <bool> compact-layout: root.width < 1020px;
    private property <bool> storage-ready: root.storage_protection_index == 1 || root.storage_protection_index == 2;
    private property <bool> auth-ready: root.service_available && root.seetaface_available && root.camera_count > 0;
    private property <bool> runtime-ready: root.auth-ready && root.storage-ready;
    private property <bool> setup-complete: root.platform_windows
        ? (root.runtime-ready && root.profiles.length > 0)
        : (root.runtime-ready && root.profiles.length > 0 && root.desktop_auth_passed && root.pam_configured);
    private property <length> page-padding: 18px;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 176px;
            background: UiTheme.surface;
            border-width: 0px;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 24px;
                padding-bottom: 20px;
                spacing: 8px;

                VerticalLayout {
                    height: 72px;
                    spacing: 4px;
                    Text { text: "Smile2Unlock"; color: UiTheme.primary; font-size: 19px; font-weight: 800; }
                    Text { text: root.translate("app.subtitle", root.language_index); color: UiTheme.text-tertiary; font-size: 12px; overflow: elide; }
                }

                NavButton {
                    label: root.translate("nav.overview", root.language_index);
                    selected: root.current_page == 0;
                    activated => { root.current_page = 0; }
                }
                NavButton {
                    label: root.translate("nav.enrollment", root.language_index);
                    selected: root.current_page == 1;
                    activated => { root.current_page = 1; }
                }
                NavButton {
                    label: root.translate("nav.settings", root.language_index);
                    selected: root.current_page == 2;
                    activated => { root.current_page = 2; }
                }
                NavButton {
                    label: root.translate("nav.diagnostics", root.language_index);
                    selected: root.current_page == 3;
                    activated => { root.current_page = 3; }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 66px;
                    border-radius: 6px;
                    background: UiTheme.surface-subtle;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 3px;
                        Text { text: root.username; color: UiTheme.text-primary; font-size: 14px; font-weight: 700; overflow: elide; }
                        Text {
                            text: root.profiles.length == 0
                                ? root.translate("account.enrollment_required", root.language_index)
                                : root.translate("account.enabled", root.language_index);
                            color: root.profiles.length == 0 ? UiTheme.warning-text : UiTheme.success-text;
                            font-size: 11px;
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: UiTheme.border;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: UiTheme.canvas;

            if root.current_page == 0: ScrollView {
                viewport-width: self.width;

                overview-content := VerticalLayout {
                    width: parent.width;
                    padding: root.page-padding;
                    spacing: 20px;

                    PageHeader {
                        title: root.translate("nav.overview", root.language_index);
                        detail: root.translate_value("overview.status_for", root.language_index, root.username);
                    }

                    if !root.compact-layout: HorizontalLayout {
                        height: 100px;
                        spacing: 12px;
                        MetricBlock {
                            horizontal-stretch: 1;
                            label: root.translate("overview.system_auth", root.language_index);
                            value: root.service_available
                                ? root.translate("status.online", root.language_index)
                                : root.translate("status.offline", root.language_index);
                            detail: root.service_available
                                ? root.translate("overview.service_available", root.language_index)
                                : root.translate("overview.service_unavailable", root.language_index);
                        }
                        MetricBlock {
                            horizontal-stretch: 1;
                            label: root.translate("overview.face_samples", root.language_index);
                            value: root.profiles.length;
                            detail: root.profiles.length == 1
                                ? root.translate("overview.one_sample", root.language_index)
                                : root.translate_value("overview.sample_count", root.language_index, root.profiles.length);
                        }
                        MetricBlock {
                            horizontal-stretch: 1;
                            label: root.translate("overview.recognizer", root.language_index);
                            value: root.seetaface_available
                                ? root.translate("status.ready", root.language_index)
                                : root.translate("status.unavailable", root.language_index);
                            detail: root.camera_count == 0
                                ? root.translate("camera.none", root.language_index)
                                : root.camera_count == 1
                                    ? root.camera_text
                                    : root.translate_value("camera.count", root.language_index, root.camera_count);
                        }
                    }

                    if root.compact-layout: VerticalLayout {
                        height: 312px;
                        spacing: 6px;
                        MetricBlock {
                            label: root.translate("overview.system_auth", root.language_index);
                            value: root.service_available
                                ? root.translate("status.online", root.language_index)
                                : root.translate("status.offline", root.language_index);
                            detail: root.service_available
                                ? root.translate("overview.service_available", root.language_index)
                                : root.translate("overview.service_unavailable", root.language_index);
                        }
                        MetricBlock {
                            label: root.translate("overview.face_samples", root.language_index);
                            value: root.profiles.length;
                            detail: root.profiles.length == 1
                                ? root.translate("overview.one_sample", root.language_index)
                                : root.translate_value("overview.sample_count", root.language_index, root.profiles.length);
                        }
                        MetricBlock {
                            label: root.translate("overview.recognizer", root.language_index);
                            value: root.seetaface_available
                                ? root.translate("status.ready", root.language_index)
                                : root.translate("status.unavailable", root.language_index);
                            detail: root.camera_count == 0
                                ? root.translate("camera.none", root.language_index)
                                : root.camera_count == 1
                                    ? root.camera_text
                                    : root.translate_value("camera.count", root.language_index, root.camera_count);
                        }
                    }

                    if !root.setup-complete: Rectangle {
                        // Auto-sized: the PAM step is Linux-only, so a fixed
                        // height would leave blank space on Windows.
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 6px;
                            SectionTitle {
                                title: root.translate("onboarding.title", root.language_index);
                                detail: root.translate("onboarding.subtitle", root.language_index);
                            }
                            SetupStep {
                                number: "1";
                                title: root.translate("onboarding.service", root.language_index);
                                detail: root.service_available && root.storage-ready
                                    ? root.translate("onboarding.service_ready", root.language_index)
                                    : root.translate("onboarding.service_action", root.language_index);
                                status: root.service_available && root.storage-ready
                                    ? root.translate("status.ready", root.language_index)
                                    : root.translate("status.action_required", root.language_index);
                                tone: root.service_available && root.storage-ready ? "good" : "warn";
                                action-label: root.translate("action.review", root.language_index);
                                activated => { root.current_page = 3; }
                            }
                            SetupStep {
                                number: "2";
                                title: root.translate("onboarding.hardware", root.language_index);
                                detail: root.seetaface_available && root.camera_count > 0
                                    ? root.translate("onboarding.hardware_ready", root.language_index)
                                    : root.translate("onboarding.hardware_action", root.language_index);
                                status: root.seetaface_available && root.camera_count > 0
                                    ? root.translate("status.ready", root.language_index)
                                    : root.translate("status.action_required", root.language_index);
                                tone: root.seetaface_available && root.camera_count > 0 ? "good" : "warn";
                                action-label: root.translate("action.review", root.language_index);
                                activated => { root.current_page = 3; }
                            }
                            SetupStep {
                                number: "3";
                                title: root.translate("onboarding.enrollment", root.language_index);
                                detail: root.profiles.length > 0
                                    ? root.translate("onboarding.enrollment_ready", root.language_index)
                                    : root.translate("onboarding.enrollment_action", root.language_index);
                                status: root.profiles.length > 0
                                    ? root.translate("status.ready", root.language_index)
                                    : root.translate("status.action_required", root.language_index);
                                tone: root.profiles.length > 0 ? "good" : "warn";
                                action-label: root.translate("action.enroll_face", root.language_index);
                                activated => { root.current_page = 1; }
                            }
                            SetupStep {
                                number: "4";
                                title: root.translate("onboarding.desktop_test", root.language_index);
                                detail: root.desktop_auth_passed
                                    ? root.translate("onboarding.desktop_test_ready", root.language_index)
                                    : root.translate("onboarding.desktop_test_action", root.language_index);
                                status: root.desktop_auth_passed
                                    ? root.translate("status.passed", root.language_index)
                                    : root.translate("status.not_tested", root.language_index);
                                tone: root.desktop_auth_passed ? "good" : "warn";
                                action-label: root.translate("action.test_auth", root.language_index);
                                action-enabled: root.auth-ready && root.profiles.length > 0 && !root.busy;
                                activated => { root.current_frame_auth_requested(); }
                            }
                            if !root.platform_windows : SetupStep {
                                number: "5";
                                title: root.translate("onboarding.pam", root.language_index);
                                detail: root.pam_configured
                                    ? root.translate_value("onboarding.pam_ready", root.language_index, root.pam_service)
                                    : root.translate("onboarding.pam_action", root.language_index);
                                status: root.pam_configured
                                    ? root.translate("status.configured", root.language_index)
                                    : root.translate("status.not_configured", root.language_index);
                                tone: root.pam_configured ? "good" : "warn";
                                action-label: root.translate("action.review", root.language_index);
                                activated => { root.current_page = 3; }
                            }
                        }
                    }

                    Rectangle {
                        height: 196px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;

                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;
                            SectionTitle {
                                title: root.translate("account.current", root.language_index);
                                detail: root.translate("account.protected_detail", root.language_index);
                            }

                            HorizontalLayout {
                                height: 52px;
                                spacing: 16px;
                                Rectangle {
                                    width: 52px;
                                    height: 52px;
                                    border-radius: 6px;
                                    background: UiTheme.surface-selected;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.username_initial;
                                        color: UiTheme.primary;
                                        font-size: 22px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: root.username; color: UiTheme.text-primary; font-size: 16px; font-weight: 700; overflow: elide; }
                                    Text {
                                        text: root.profiles.length == 0
                                            ? root.translate("account.no_samples", root.language_index)
                                            : root.translate_value("account.sample_count", root.language_index, root.profiles.length);
                                        color: UiTheme.text-secondary;
                                        font-size: 13px;
                                    }
                                }
                                CenteredStatusPill {
                                    width: root.profiles.length == 0 ? 132px : 92px;
                                    label: root.profiles.length == 0
                                        ? root.translate("status.action_required", root.language_index)
                                        : root.translate("status.protected", root.language_index);
                                    tone: root.profiles.length == 0 ? "warn" : "good";
                                }
                                CenteredActionButton {
                                    width: 124px;
                                    label: root.profiles.length == 0
                                        ? root.translate("action.enroll_face", root.language_index)
                                        : root.translate("action.manage_faces", root.language_index);
                                    primary: root.profiles.length == 0;
                                    activated => { root.current_page = 1; }
                                }
                            }

                            Rectangle { height: 1px; background: UiTheme.divider; }

                            HorizontalLayout {
                                height: 26px;
                                spacing: 12px;
                                Text { text: root.translate("overview.last_check", root.language_index); color: UiTheme.text-secondary; font-size: 12px; vertical-alignment: center; }
                                Text { text: root.activity_title; color: UiTheme.text-primary; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                StatusPill {
                                    width: 92px;
                                    label: root.busy
                                        ? root.translate("status.working", root.language_index)
                                        : root.activity_tone == "good"
                                            ? root.translate("status.passed", root.language_index)
                                            : root.activity_tone == "bad"
                                                ? root.translate("status.failed", root.language_index)
                                                : root.translate("status.idle", root.language_index);
                                    tone: root.busy ? "warn" : root.activity_tone;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 144px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;

                        HorizontalLayout {
                            padding: 20px;
                            spacing: 20px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                VerticalLayout {
                                    height: 50px;
                                    spacing: 7px;
                                    Text { text: root.translate("overview.verify_account", root.language_index); color: UiTheme.text-primary; font-size: 16px; font-weight: 700; }
                                    Text {
                                        text: root.activity_detail == ""
                                            ? root.translate("overview.verify_hint", root.language_index)
                                            : root.activity_detail;
                                        color: UiTheme.text-secondary;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                            CenteredActionButton {
                                width: 150px;
                                label: root.busy
                                    ? root.translate("status.checking", root.language_index)
                                    : root.translate("action.test_auth", root.language_index);
                                primary: true;
                                enabled: !root.busy && root.auth-ready && root.profiles.length > 0;
                                activated => { root.current_frame_auth_requested(); }
                            }
                        }
                    }
                }
            }

            if root.current_page == 1: ScrollView {
                viewport-width: self.width;

                enrollment-content := VerticalLayout {
                    width: parent.width;
                    padding: root.page-padding;
                    spacing: 20px;

                    PageHeader {
                        title: root.translate("nav.enrollment", root.language_index);
                        detail: root.translate_value("enrollment.manage_for", root.language_index, root.username);
                    }

                    HorizontalLayout {
                        height: 352px;
                        spacing: 18px;

                        preview-frame := Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: UiTheme.preview-surface;
                            clip: true;
                            property <length> fitted_width: root.preview_source_width > 0 && root.preview_source_height > 0
                                ? Math.min(self.width, self.height * root.preview_source_width / root.preview_source_height)
                                : self.width;
                            property <length> fitted_height: root.preview_source_width > 0 && root.preview_source_height > 0
                                ? Math.min(self.height, self.width * root.preview_source_height / root.preview_source_width)
                                : self.height;
                            property <float> source_scale: root.preview_source_width > 0
                                ? self.fitted_width / 1px / root.preview_source_width
                                : 1;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.preview_image;
                                image-fit: contain;
                            }
                            Rectangle {
                                x: (preview-frame.width - preview-frame.fitted_width) / 2
                                    + root.face_box_x * preview-frame.source_scale * 1px;
                                y: (preview-frame.height - preview-frame.fitted_height) / 2
                                    + root.face_box_y * preview-frame.source_scale * 1px;
                                width: root.face_box_w * preview-frame.source_scale * 1px;
                                height: root.face_box_h * preview-frame.source_scale * 1px;
                                visible: root.face_box_visible;
                                border-color: UiTheme.face-indicator;
                                border-width: 2px;
                                background: transparent;
                            }
                            Rectangle {
                                x: 14px;
                                y: parent.height - 42px;
                                width: Math.min(220px, parent.width - 28px);
                                height: 28px;
                                border-radius: 4px;
                                background: UiTheme.preview-overlay;
                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: root.preview_status_text;
                                    color: UiTheme.preview-text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        Rectangle {
                            width: 284px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: UiTheme.border;
                            background: UiTheme.surface;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;
                                SectionTitle {
                                    title: root.translate("enrollment.capture", root.language_index);
                                    detail: root.camera_count == 0
                                        ? root.translate("camera.none", root.language_index)
                                        : root.camera_count == 1
                                            ? root.camera_text
                                            : root.translate_value("camera.count", root.language_index, root.camera_count);
                                }
                                Text { text: root.translate("enrollment.sample_name", root.language_index); color: UiTheme.text-secondary; font-size: 12px; font-weight: 600; }
                                LineEdit { text <=> root.enroll_label_text; enabled: !root.busy; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton { horizontal-stretch: 1; label: root.translate("action.start_camera", root.language_index); enabled: !root.busy && root.camera_count > 0; activated => { root.start_preview_requested(); } }
                                    ActionButton { horizontal-stretch: 1; label: root.translate("action.stop", root.language_index); enabled: !root.busy; activated => { root.stop_preview_requested(); } }
                                }
                                ActionButton {
                                    label: root.busy
                                        ? root.translate("status.capturing", root.language_index)
                                        : root.translate("action.capture_sample", root.language_index);
                                    primary: true;
                                    enabled: !root.busy && root.auth-ready;
                                    activated => { root.enroll_current_frame_requested(root.enroll_label_text); }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text { text: root.activity_detail; color: root.activity_tone == "bad" ? UiTheme.danger-text : UiTheme.text-secondary; font-size: 12px; wrap: word-wrap; max-height: 42px; }
                            }
                        }
                    }

                    SectionTitle {
                        title: root.translate("enrollment.enrolled_samples", root.language_index);
                        detail: root.profiles.length == 0
                            ? root.translate("enrollment.no_samples", root.language_index)
                            : root.translate_value("enrollment.sample_count", root.language_index, root.profiles.length);
                    }

                    if root.profiles.length == 0: Rectangle {
                        height: 92px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        Text { width: parent.width; height: parent.height; text: root.translate("enrollment.empty", root.language_index); color: UiTheme.text-tertiary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    for profile in root.profiles: Rectangle {
                        height: 64px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 14px;
                            VerticalLayout {
                                width: 8px;
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: UiTheme.success-text; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                VerticalLayout {
                                    height: 37px;
                                    spacing: 3px;
                                    Text { text: profile.label; color: UiTheme.text-primary; font-size: 14px; font-weight: 700; overflow: elide; }
                                    Text { text: root.translate_value("enrollment.enrolled_at", root.language_index, profile.enrolled_at); color: UiTheme.text-tertiary; font-size: 11px; }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                            CenteredActionButton {
                                width: 86px;
                                label: root.translate("action.remove", root.language_index);
                                danger: true;
                                enabled: !root.busy;
                                activated => { root.delete_profile_requested(profile.id); }
                            }
                        }
                    }
                }
            }

            if root.current_page == 2: ScrollView {
                viewport-width: self.width;

                settings-content := VerticalLayout {
                    width: parent.width;
                    padding: root.page-padding;
                    spacing: 20px;

                    PageHeader {
                        title: root.translate("nav.settings", root.language_index);
                        detail: root.translate("settings.subtitle", root.language_index);
                    }

                    Rectangle {
                        height: 214px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            SectionTitle {
                                title: root.translate("settings.camera", root.language_index);
                                detail: root.translate("settings.camera_detail", root.language_index);
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                ComboBox { horizontal-stretch: 1; model: root.camera_options; current-index <=> root.selected_camera; }
                                Text { width: 84px; text: root.translate("settings.preview_fps", root.language_index); color: UiTheme.text-secondary; font-size: 12px; vertical-alignment: center; }
                                SpinBox { width: 100px; minimum: 1; maximum: 60; value <=> root.preview_fps; }
                            }
                            Rectangle { height: 1px; background: UiTheme.divider; }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { width: 84px; text: root.translate("settings.language", root.language_index); color: UiTheme.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: root.language_names;
                                    current-index <=> root.language_index;
                                    selected(_) => {
                                        root.activity_title = root.translate("activity.not_checked", root.language_index);
                                        root.activity_detail = "";
                                        root.settings_status = root.translate("settings.saved", root.language_index);
                                        root.language_selected(root.language_index);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 184px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            SectionTitle {
                                title: root.translate("settings.appearance", root.language_index);
                                detail: root.translate("settings.appearance_detail", root.language_index);
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    width: 132px;
                                    text: root.translate("settings.theme_mode", root.language_index);
                                    color: UiTheme.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                SegmentedSelector {
                                    horizontal-stretch: 1;
                                    options: [
                                        root.translate("settings.theme_system", root.language_index),
                                        root.translate("settings.theme_light", root.language_index),
                                        root.translate("settings.theme_dark", root.language_index),
                                    ];
                                    current-index <=> root.theme_mode_index;
                                    selected(index) => { root.theme_mode_selected(index); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    width: 132px;
                                    text: root.translate("settings.window_controls", root.language_index);
                                    color: UiTheme.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                SegmentedSelector {
                                    horizontal-stretch: 1;
                                    options: [
                                        root.translate("settings.window_controls_auto", root.language_index),
                                        root.translate("settings.window_controls_show", root.language_index),
                                        root.translate("settings.window_controls_hide", root.language_index),
                                    ];
                                    current-index <=> root.window_controls_index;
                                    selected(index) => { root.window_controls_selected(index); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 260px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            SectionTitle {
                                title: root.translate("settings.recognition_policy", root.language_index);
                                detail: root.translate("settings.policy_detail", root.language_index);
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text { text: root.translate("settings.recognition_threshold", root.language_index); color: UiTheme.text-primary; font-size: 13px; font-weight: 600; }
                                    Slider { minimum: 0.35; maximum: 0.95; value <=> root.recognition_threshold; }
                                }
                                StatusPill { width: 70px; label: Math.round(root.recognition_threshold * 100) + "%"; tone: root.recognition_threshold < 0.5 ? "warn" : "neutral"; }
                            }
                            Rectangle { height: 1px; background: UiTheme.divider; }
                            Switch {
                                text: root.translate("settings.liveness_enabled", root.language_index);
                                checked <=> root.liveness_enabled;
                                toggled => { root.settings_status = root.translate("settings.unsaved", root.language_index); }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text { text: root.translate("settings.liveness_threshold", root.language_index); color: root.liveness_enabled ? UiTheme.text-primary : UiTheme.disabled-text; font-size: 13px; font-weight: 600; }
                                    Slider { enabled: root.liveness_enabled; minimum: 0.2; maximum: 0.95; value <=> root.liveness_threshold; }
                                }
                                StatusPill { width: 70px; label: Math.round(root.liveness_threshold * 100) + "%"; tone: "neutral"; }
                            }
                        }
                    }

                    // Recognition trigger policy: Windows-only (the
                    // credential provider consumes it at lock-screen time;
                    // Linux uses the PAM/service flow and hides these).
                    // Conditional element: on Linux it is not instantiated
                    // at all, so it leaves no blank space in the layout.
                    if root.platform_windows : Rectangle {
                        height: 280px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            SectionTitle {
                                title: root.translate("settings.recognition_trigger", root.language_index);
                                detail: root.translate("settings.trigger_detail", root.language_index);
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    width: 132px;
                                    text: root.translate("settings.recognition_mode", root.language_index);
                                    color: UiTheme.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                SegmentedSelector {
                                    horizontal-stretch: 1;
                                    options: [
                                        root.translate("settings.mode_manual", root.language_index),
                                        root.translate("settings.mode_auto", root.language_index),
                                    ];
                                    current-index <=> root.recognition_mode;
                                    selected(index) => { root.settings_status = root.translate("settings.unsaved", root.language_index); }
                                }
                            }
                            Rectangle { height: 1px; background: UiTheme.divider; }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text { text: root.translate("settings.auto_delay", root.language_index); color: root.recognition_mode == 1 ? UiTheme.text-primary : UiTheme.disabled-text; font-size: 13px; font-weight: 600; }
                                    Text { text: root.translate("settings.auto_delay_detail", root.language_index); color: UiTheme.text-secondary; font-size: 11px; wrap: word-wrap; }
                                }
                                SpinBox {
                                    enabled: root.recognition_mode == 1;
                                    minimum: 0;
                                    maximum: 3600;
                                    value <=> root.auto_delay_sec;
                                    edited => { root.settings_status = root.translate("settings.unsaved", root.language_index); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text { text: root.translate("settings.retry_delay", root.language_index); color: root.recognition_mode == 1 ? UiTheme.text-primary : UiTheme.disabled-text; font-size: 13px; font-weight: 600; }
                                    Text { text: root.translate("settings.retry_delay_detail", root.language_index); color: UiTheme.text-secondary; font-size: 11px; wrap: word-wrap; }
                                }
                                SpinBox {
                                    enabled: root.recognition_mode == 1;
                                    minimum: 1;
                                    maximum: 3600;
                                    value <=> root.retry_delay_sec;
                                    edited => { root.settings_status = root.translate("settings.unsaved", root.language_index); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text { text: root.translate("settings.timeout", root.language_index); color: UiTheme.text-secondary; font-size: 13px; font-weight: 600; }
                                    Text { text: root.translate("settings.timeout_detail", root.language_index); color: UiTheme.text-secondary; font-size: 11px; wrap: word-wrap; }
                                }
                                SpinBox {
                                    minimum: 5;
                                    maximum: 600;
                                    value <=> root.timeout_sec;
                                    edited => { root.settings_status = root.translate("settings.unsaved", root.language_index); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 12px;
                        Text { text: root.settings_status; color: UiTheme.text-secondary; font-size: 12px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ActionButton {
                            width: 128px;
                            label: root.translate("action.save_settings", root.language_index);
                            primary: true;
                            enabled: !root.busy;
                            activated => {
                                root.save_settings_requested(
                                    root.selected_camera,
                                    root.recognition_threshold,
                                    root.liveness_enabled,
                                    root.liveness_threshold,
                                    root.preview_fps,
                                    root.recognition_mode,
                                    root.auto_delay_sec,
                                    root.retry_delay_sec,
                                    root.timeout_sec);
                            }
                        }
                    }
                }
            }

            if root.current_page == 3: ScrollView {
                viewport-width: self.width;

                diagnostics-content := VerticalLayout {
                    width: parent.width;
                    padding: root.page-padding;
                    spacing: 20px;

                    PageHeader {
                        title: root.translate("nav.diagnostics", root.language_index);
                        detail: root.translate("diagnostics.subtitle", root.language_index);
                    }

                    if !root.platform_windows : DeploymentPanel {
                        targets: root.deployment_targets;
                        helper_available: root.deployment_helper_available;
                        installer_available: root.deployment_installer_available;
                        runtime_ready: root.runtime-ready;
                        busy: root.busy;
                        language_index: root.language_index;
                        operation_status: root.deployment_operation_status;
                        translate(key, index) => { root.translate(key, index) }
                        initialize_requested => { root.initialize_system_deployment_requested(); }
                        install_helper_requested => { root.install_deployment_helper_requested(); }
                        configure_requested(target, wallet) => {
                            root.configure_desktop_target_requested(target, wallet);
                        }
                        rollback_requested(target) => {
                            root.rollback_desktop_target_requested(target);
                        }
                    }

                    // Runtime card: auto-sized so the PAM rows (Linux only)
                    // do not leave blank space on Windows.
                    Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 48px;
                                SectionTitle { horizontal-stretch: 1; title: root.translate("diagnostics.runtime", root.language_index); detail: root.core_version; }
                                CenteredActionButton {
                                    width: 112px;
                                    label: root.translate("action.refresh", root.language_index);
                                    enabled: !root.busy;
                                    activated => { root.refresh_system_status_requested(); }
                                }
                            }
                            DiagnosticRow {
                                label: root.translate("diagnostics.auth_service", root.language_index);
                                status: root.service_available ? root.translate("status.online", root.language_index) : root.translate("status.offline", root.language_index);
                                detail: root.service_available ? root.translate("diagnostics.service_ready_detail", root.language_index) : root.translate("diagnostics.service_action", root.language_index);
                                tone: root.service_available ? "good" : "bad";
                            }
                            DiagnosticRow {
                                label: root.translate("diagnostics.storage", root.language_index);
                                status: root.storage_protection_index == 2
                                    ? root.translate("diagnostics.storage_tpm", root.language_index)
                                    : root.storage_protection_index == 1
                                        ? root.translate("diagnostics.storage_host", root.language_index)
                                        : root.storage_protection_index == 3
                                            ? root.translate("status.unknown", root.language_index)
                                            : root.translate("status.unavailable", root.language_index);
                                detail: root.storage-ready ? root.translate("diagnostics.storage_ready_detail", root.language_index) : root.translate("diagnostics.storage_action", root.language_index);
                                tone: root.storage-ready ? "good" : "bad";
                            }
                            DiagnosticRow {
                                label: root.translate("diagnostics.recognizer", root.language_index);
                                status: root.seetaface_available ? root.translate("status.available", root.language_index) : root.translate("status.unavailable", root.language_index);
                                detail: root.seetaface_available ? root.translate("diagnostics.recognizer_ready_detail", root.language_index) : root.translate("diagnostics.recognizer_action", root.language_index);
                                tone: root.seetaface_available ? "good" : "bad";
                            }
                            DiagnosticRow {
                                label: root.translate("settings.camera", root.language_index);
                                status: root.camera_count == 0 ? root.translate("camera.none", root.language_index) : root.camera_text;
                                detail: root.camera_count == 0 ? root.translate("diagnostics.camera_action", root.language_index) : root.translate("diagnostics.camera_ready_detail", root.language_index);
                                tone: root.camera_count > 0 ? "good" : "bad";
                            }
                            DiagnosticRow {
                                label: root.translate("overview.face_samples", root.language_index);
                                status: root.profiles.length == 0 ? root.translate("enrollment.no_samples", root.language_index) : root.translate_value("enrollment.sample_count", root.language_index, root.profiles.length);
                                detail: root.profiles.length == 0 ? root.translate("diagnostics.profiles_action", root.language_index) : root.translate("diagnostics.profiles_ready_detail", root.language_index);
                                tone: root.profiles.length > 0 ? "good" : "warn";
                            }
                            if !root.platform_windows : DiagnosticRow {
                                label: root.translate("diagnostics.login_pam", root.language_index);
                                status: !root.pam_status_known
                                    ? root.translate("status.unknown", root.language_index)
                                    : root.login_pam_configured
                                        ? root.translate("status.configured", root.language_index)
                                        : root.translate("status.not_configured", root.language_index);
                                detail: root.login_pam_configured
                                    ? root.translate("diagnostics.login_pam_ready", root.language_index)
                                    : root.translate("diagnostics.login_pam_action", root.language_index);
                                tone: root.login_pam_configured ? "good" : "warn";
                            }
                            if !root.platform_windows : DiagnosticRow {
                                label: root.translate("diagnostics.lock_pam", root.language_index);
                                status: !root.pam_status_known
                                    ? root.translate("status.unknown", root.language_index)
                                    : root.lock_pam_configured
                                        ? root.translate("status.configured", root.language_index)
                                        : root.translate("status.not_configured", root.language_index);
                                detail: root.lock_pam_configured
                                    ? root.translate("diagnostics.lock_pam_ready", root.language_index)
                                    : root.translate("diagnostics.lock_pam_action", root.language_index);
                                tone: root.lock_pam_configured ? "good" : "warn";
                            }
                        }
                    }

                    Rectangle {
                        height: 170px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 10px;
                            SectionTitle { title: root.translate("diagnostics.local_data", root.language_index); detail: root.translate("diagnostics.local_data_detail", root.language_index); }
                            VerticalLayout {
                                height: 36px;
                                spacing: 3px;
                                Text { text: root.translate("diagnostics.configuration", root.language_index); color: UiTheme.text-secondary; font-size: 11px; font-weight: 600; }
                                Text { text: root.config_path_text; color: UiTheme.text-primary; font-size: 12px; overflow: elide; }
                            }
                            VerticalLayout {
                                height: 36px;
                                spacing: 3px;
                                Text { text: root.translate("overview.face_samples", root.language_index); color: UiTheme.text-secondary; font-size: 11px; font-weight: 600; }
                                Text { text: root.profile_store_path_text; color: UiTheme.text-primary; font-size: 12px; overflow: elide; }
                            }
                        }
                    }

                    if !root.platform_windows : Rectangle {
                        height: 118px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: UiTheme.border;
                        background: UiTheme.surface;
                        HorizontalLayout {
                            padding: 20px;
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                VerticalLayout {
                                    height: 44px;
                                    spacing: 6px;
                                    Text { text: root.translate("diagnostics.desktop_auth_check", root.language_index); color: UiTheme.text-primary; font-size: 15px; font-weight: 700; }
                                    Text { text: root.translate("diagnostics.desktop_auth_detail", root.language_index); color: UiTheme.text-secondary; font-size: 12px; overflow: elide; }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                            CenteredActionButton {
                                width: 140px;
                                label: root.busy
                                    ? root.translate("status.checking", root.language_index)
                                    : root.translate("action.run_check", root.language_index);
                                primary: true;
                                enabled: !root.busy && root.auth-ready && root.profiles.length > 0;
                                activated => { root.current_frame_auth_requested(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
