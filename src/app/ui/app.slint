import { Button, LineEdit } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <string> title_text: "Smile2Unlock";
    in property <string> core_version: "Core v0";
    in property <string> threshold_text: "0.65";
    in property <string> preview_fps_text: "15";
    in property <string> liveness_text: "Enabled";
    in property <string> config_path_text: "";
    in property <string> profile_store_path_text: "";
    in property <string> camera_text: "No cameras";
    in property <string> profile_text: "";
    in-out property <string> delete_profile_id_text: "";
    in-out property <string> enroll_label_text: "Demo Face";
    in-out property <string> enroll_sample_source_text: "mock:face:demo:front";
    in-out property <string> probe_sample_source_text: "mock:face:demo:front";
    in-out property <string> auth_text: "Not checked";
    in-out property <string> auth_score_text: "-";
    in-out property <string> auth_best_profile_text: "-";
    in-out property <string> auth_reason_text: "-";
    in-out property <string> debug_json_text: "Sample sources: mock:<id> or image:<path>";

    callback demo_auth_requested();
    callback enroll_requested(string, string);
    callback face_auth_requested(string);
    callback delete_profile_requested(string);
    callback refresh_profiles_requested();

    title: title_text;
    width: 960px;
    height: 640px;

    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        Text {
            text: title_text;
            font-size: 28px;
            font-weight: 700;
        }

        Text {
            text: core_version;
            font-size: 16px;
        }

        GridLayout {
            spacing: 8px;

            Row {
                Text { text: "Threshold"; font-weight: 700; }
                Text { text: threshold_text; }
            }

            Row {
                Text { text: "Preview FPS"; font-weight: 700; }
                Text { text: preview_fps_text; }
            }

            Row {
                Text { text: "Liveness"; font-weight: 700; }
                Text { text: liveness_text; }
            }

            Row {
                Text { text: "Camera"; font-weight: 700; }
                Text { text: camera_text; }
            }

            Row {
                Text { text: "Config"; font-weight: 700; }
                Text { text: config_path_text; }
            }

            Row {
                Text { text: "Profiles"; font-weight: 700; }
                Text { text: profile_store_path_text; }
            }

            Row {
                Text { text: "Auth"; font-weight: 700; }
                Text { text: auth_text; }
            }
        }

        GridLayout {
            spacing: 8px;

            Row {
                Text { text: "Label"; font-weight: 700; }
                LineEdit { text <=> root.enroll_label_text; }
            }

            Row {
                Text { text: "Enroll Source"; font-weight: 700; }
                LineEdit { text <=> root.enroll_sample_source_text; }
            }

            Row {
                Text { text: "Probe Source"; font-weight: 700; }
                LineEdit { text <=> root.probe_sample_source_text; }
            }

            Row {
                Text { text: "Delete ID"; font-weight: 700; }
                LineEdit { text <=> root.delete_profile_id_text; }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Button {
                text: "Enroll";
                clicked => {
                    root.enroll_requested(root.enroll_label_text, root.enroll_sample_source_text);
                }
            }

            Button {
                text: "Authenticate";
                clicked => {
                    root.face_auth_requested(root.probe_sample_source_text);
                }
            }

            Button {
                text: "Refresh";
                clicked => {
                    root.refresh_profiles_requested();
                }
            }

            Button {
                text: "Delete";
                clicked => {
                    root.delete_profile_requested(root.delete_profile_id_text);
                }
            }

            Button {
                text: "Run Demo Auth";
                clicked => {
                    root.demo_auth_requested();
                }
            }
        }

        GridLayout {
            spacing: 8px;

            Row {
                Text { text: "Score"; font-weight: 700; }
                Text { text: auth_score_text; }
            }

            Row {
                Text { text: "Best Profile"; font-weight: 700; }
                Text { text: auth_best_profile_text; }
            }

            Row {
                Text { text: "Reason"; font-weight: 700; }
                Text { text: auth_reason_text; }
            }
        }

        Text {
            text: profile_text;
            font-size: 12px;
        }

        Text {
            text: debug_json_text;
            font-size: 12px;
        }
    }
}
