import { CapturePanel, CaptureRow } from "captures.slint";
export { CaptureRow } from "captures.slint";
import { Palette } from "std-widgets.slint";
export { UiTheme } from "theme.slint";
export { Tr } from "i18n.slint";
export { ProfileRow } from "components.slint";
export { DeploymentTargetRow } from "deployment.slint";
export { ContributorRow, LicenseSummaryRow } from "about.slint";
import { AboutContent, ContributorRow, LicenseSummaryRow } from "about.slint";
import { Dropdown, Stepper, TextField } from "inputs.slint";
import { UiTheme } from "theme.slint";
import { Tr } from "i18n.slint";
import { KeyringGroup } from "wallet.slint";
import { CaptureControls, PreviewFrame } from "faces.slint";
import { DeploymentTargetRow, ModelsGroup, SystemSetupGroup, TargetGroups } from "deployment.slint";
import {
    Badge, Button, ButtonKind, Check, Group, NavItem, Note, Page, PageHeader, ProfileRow, Row,
    SegmentedSelector, Status, Tone, Toggle, ValueSlider,
} from "components.slint";

export component AppWindow inherits Window {
    in property <string> title_text: "Smile2Unlock";
    in property <string> username: "";
    in property <string> username_initial: "U";
    in property <string> core_version: "";
    in property <string> app_version: "";
    in property <[ContributorRow]> contributors;
    in property <[LicenseSummaryRow]> open_source_components;
    in property <[string]> license_names;
    in-out property <int> license_index: 0;
    in property <string> license_text: "";
    in property <string> about_link_status: "";
    in-out property <bool> diagnostics_exporting: false;
    in property <string> diagnostics_archive: "";
    in property <string> diagnostics_error: "";
    in property <string> diagnostics_system_unavailable: "";
    in property <string> config_path_text: "";
    in property <string> profile_store_path_text: "";
    in property <string> camera_text: "";
    in property <int> camera_count: 0;
    in property <bool> seetaface_available: false;
    in property <bool> service_available: false;
    in property <bool> account_credential_configured: false;
    in property <bool> authtok_status_known: false;
    in property <bool> authtok_enrolled: false;
    in property <bool> sealed_login_deployed: false;
    in-out property <string> wallet_password_text: "";
    in property <string> wallet_operation_status: "";
    in property <int> storage_protection_index: 0;
    in property <bool> pam_status_known: false;
    in property <bool> pam_configured: false;
    in property <string> pam_service: "";
    in property <bool> deployment_helper_available: false;
    in property <bool> deployment_installer_available: false;
    in property <bool> login_pam_configured: false;
    in property <bool> lock_pam_configured: false;
    in property <[DeploymentTargetRow]> deployment_targets;
    in property <[DeploymentTargetRow]> login_targets;
    in property <[DeploymentTargetRow]> lock_targets;
    in property <[DeploymentTargetRow]> privilege_targets;
    in-out property <string> deployment_operation_status: "";
    in-out property <bool> models_present: true;
    in-out property <bool> models_downloading: false;
    in-out property <float> models_progress: 0;
    in-out property <string> models_status_text: "";
    in-out property <bool> desktop_auth_passed: false;
    in property <[ProfileRow]> profiles;
    in property <[string]> camera_options;
    in property <[string]> language_names;

    in property <image> preview_image;
    in property <float> face_box_x;
    in property <float> face_box_y;
    in property <float> face_box_w;
    in property <float> face_box_h;
    in property <bool> face_box_visible: false;
    in property <int> preview_source_width;
    in property <int> preview_source_height;
    in-out property <string> preview_status_text: "";
    in-out property <string> preview_error_text: "";

    // 0 overview, 1 faces, 2 sign-in & unlock (Linux), 3 settings, 4 diagnostics, 5 about.
    in-out property <int> current_page: 0;
    changed current_page => {
        if root.current_page == 3 { root.capture_refresh(); }
        if (root.current_page == 1 || root.current_page == 2) && !root.platform_windows {
            root.refresh_system_status_requested();
            root.refresh_profiles_requested();
        }
        root.wallet_password_text = "";
    }
    in-out property <int> language_index <=> Tr.language-index;
    in-out property <int> theme_mode_index: 0;
    in-out property <int> window_controls_index: 0;
    in property <bool> window_frame_visible: true;
    in-out property <string> enroll_label_text: "";
    in-out property <string> account_password_text: "";
    in-out property <string> activity_title: "";
    in-out property <string> activity_detail: "";
    in-out property <string> activity_tone: "neutral";
    in-out property <bool> busy: false;
    in-out property <int> selected_camera: 0;
    in-out property <float> recognition_threshold: 0.65;
    in-out property <bool> liveness_enabled: true;
    in-out property <float> liveness_threshold: 0.5;
    in-out property <bool> backlight_compensation: true;
    in-out property <int> preview_fps: 15;
    in-out property <string> settings_status: "";
    in-out property <bool> capture_enabled: false;
    in-out property <int> capture_days: 7;
    in-out property <int> capture_max_count: 50;
    in property <[CaptureRow]> captures;
    in-out property <image> capture_selected_image;
    in-out property <bool> capture_selected: false;
    in property <string> capture_status;
    callback capture_refresh();
    callback capture_open(string);
    callback capture_delete(string);
    callback capture_delete_all();
    // Recognition trigger policy (Windows only; hidden on Linux).
    in property <bool> platform_windows: false;
    in-out property <int> recognition_mode: 0;
    in-out property <int> auto_delay_sec: 3;
    in-out property <int> retry_delay_sec: 5;
    in-out property <int> timeout_sec: 30;

    callback enroll_current_frame_requested(string);
    callback configure_account_credential_requested(string);
    callback current_frame_auth_requested();
    callback delete_profile_requested(string);
    callback refresh_profiles_requested();
    callback refresh_system_status_requested();
    callback export_diagnostics_requested();
    callback show_diagnostics_requested();
    callback install_deployment_helper_requested();
    callback initialize_system_deployment_requested();
    callback models_download_requested(bool, string);
    callback configure_desktop_target_requested(string, int);
    callback save_wallet_password_requested(string);
    callback clear_wallet_password_requested();
    pure callback wallet_use_reason(bool, bool, bool, bool, bool) -> string;
    callback rollback_desktop_target_requested(string);
    callback start_preview_requested();
    callback stop_preview_requested();
    callback save_settings_requested(int, float, bool, float, bool, int, int, int, int, int);
    callback language_selected(int);
    callback theme_mode_selected(int);
    callback window_controls_selected(int);
    callback license_selected(int);
    callback project_link_requested(int);
    callback contributor_link_requested(int);

    private property <bool> dark-mode: UiTheme.dark-mode;

    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    // One family for all text so CJK glyphs do not mix faces; empty = Slint default.
    in property <string> ui_font_family: "";
    default-font-family: root.ui_font_family;
    title: title_text;
    // NOTE: no `icon:` property here. slint 1.17's compiler never embeds
    // Window.icon images; it generates Image::load_from_path() with the
    // build-machine's absolute path, which does not exist at deploy time.
    // The window icon is set at runtime from the .ico next to the
    // executable (see slint_main.cpp), and the exe embeds the icon via a
    // .rc resource so Explorer/taskbar fall back to it.
    no-frame: !root.window_frame_visible;
    // No explicit width/height: an explicit size would bind the window to
    // that size (update_window_properties re-applies it, making the window
    // non-resizable and oversized on small screens). The initial size is
    // chosen by su_app at startup to fit the desktop; preferred-* only
    // guides the layout.
    preferred-width: UiTheme.window-width;
    preferred-height: UiTheme.window-height;
    background: UiTheme.canvas;

    private property <bool> compact-layout: root.width - UiTheme.sidebar-width < UiTheme.compact-width;
    private property <bool> storage-ready: root.storage_protection_index == 1 || root.storage_protection_index == 2;
    private property <bool> auth-ready: root.service_available && root.seetaface_available && root.camera_count > 0;
    private property <bool> runtime-ready: root.auth-ready && root.storage-ready;
    private property <bool> can-test: !root.busy && root.auth-ready && root.profiles.length > 0;
    private property <bool> setup-complete: root.platform_windows
        ? (root.runtime-ready && root.profiles.length > 0)
        : (root.runtime-ready && root.profiles.length > 0 && root.desktop_auth_passed && root.pam_configured);
    private property <bool> step-service: root.service_available && root.storage-ready;
    private property <bool> step-hardware: root.seetaface_available && root.camera_count > 0;
    private property <bool> step-enroll: root.profiles.length > 0;
    private property <bool> step-test: root.desktop_auth_passed;
    private property <bool> step-pam: root.pam_configured;
    // The first unfinished setup step (1..5), or 0 when everything is done.
    private property <int> next-step: !root.step-service ? 1
        : !root.step-hardware ? 2
        : !root.step-enroll ? 3
        : !root.step-test ? 4
        : !root.platform_windows && !root.step-pam ? 5 : 0;
    private property <string> faces-text: root.profiles.length == 0 ? Tr.t("overview.faces_none")
        : root.profiles.length == 1 ? Tr.t("overview.faces_one")
        : Tr.tv("overview.faces_many", root.profiles.length);
    private property <string> hero-summary: root.platform_windows ? root.faces-text
        : root.faces-text
            + " · " + (root.lock_pam_configured ? Tr.t("overview.lock_on") : Tr.t("overview.lock_off"))
            + " · " + (root.login_pam_configured ? Tr.t("overview.login_on") : Tr.t("overview.login_off"));
    private property <string> camera-summary: root.camera_count == 0 ? Tr.t("camera.none")
        : root.camera_count == 1 ? root.camera_text
        : Tr.tv("camera.count", root.camera_count);

    HorizontalLayout {
        spacing: 0;

        Rectangle {
            width: UiTheme.sidebar-width;
            background: UiTheme.sidebar;

            VerticalLayout {
                padding: UiTheme.s4;
                padding-top: UiTheme.s6;
                spacing: UiTheme.s1;

                VerticalLayout {
                    padding-left: UiTheme.s4;
                    padding-bottom: UiTheme.s6;
                    spacing: UiTheme.s1;
                    Text { text: "Smile2Unlock"; color: UiTheme.text; font-size: UiTheme.font-brand; font-weight: UiTheme.weight-bold; overflow: elide; }
                    Text { text: Tr.t("app.subtitle"); color: UiTheme.text-faint; font-size: UiTheme.font-small; overflow: elide; }
                }

                NavItem { text: Tr.t("nav.overview"); selected: root.current_page == 0; activated => { root.current_page = 0; } }
                NavItem { text: Tr.t("nav.faces"); selected: root.current_page == 1; activated => { root.current_page = 1; } }
                if !root.platform_windows: NavItem { text: Tr.t("nav.login"); selected: root.current_page == 2; activated => { root.current_page = 2; } }
                NavItem { text: Tr.t("nav.settings"); selected: root.current_page == 3; activated => { root.current_page = 3; } }
                NavItem { text: Tr.t("nav.diagnostics"); selected: root.current_page == 4; activated => { root.current_page = 4; } }
                NavItem { text: Tr.t("nav.about"); selected: root.current_page == 5; activated => { root.current_page = 5; } }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    padding: UiTheme.s3;
                    spacing: UiTheme.s3;
                    Rectangle {
                        width: UiTheme.avatar;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: UiTheme.tonal;
                        Text { text: root.username_initial; color: UiTheme.on-tonal; font-weight: UiTheme.weight-bold; font-size: UiTheme.font-row-title; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: UiTheme.unit / 2;
                        horizontal-stretch: 1;
                        Text { text: root.username; color: UiTheme.text; font-weight: UiTheme.weight-bold; font-size: UiTheme.font-body; overflow: elide; }
                        Text {
                            text: root.profiles.length == 0 ? Tr.t("account.enrollment_required") : Tr.t("account.enabled");
                            color: root.profiles.length == 0 ? UiTheme.warn : UiTheme.ok;
                            font-size: UiTheme.font-small;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: UiTheme.canvas;

            if root.current_page == 0: Page {
                PageHeader {
                    title: Tr.t("nav.overview");
                    subtitle: Tr.tv("overview.status_for", root.username);
                }
                // Hero: overall state and the one main action.
                Rectangle {
                    background: UiTheme.group;
                    border-radius: UiTheme.radius-group;
                    HorizontalLayout {
                        padding: UiTheme.s6;
                        spacing: UiTheme.s5;
                        Rectangle {
                            width: UiTheme.hero-badge;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: root.setup-complete ? UiTheme.ok-bg : UiTheme.warn-bg;
                            Text {
                                text: root.setup-complete ? "✓" : "!";
                                color: root.setup-complete ? UiTheme.ok : UiTheme.warn;
                                font-size: UiTheme.font-stat;
                                font-weight: UiTheme.weight-bold;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: UiTheme.s1;
                            horizontal-stretch: 1;
                            Text {
                                text: root.setup-complete ? Tr.t("overview.ready") : Tr.t("overview.not_ready");
                                color: UiTheme.text;
                                font-size: UiTheme.font-hero;
                                font-weight: UiTheme.weight-bold;
                                wrap: word-wrap;
                            }
                            Text { text: root.hero-summary; color: UiTheme.text-dim; font-size: UiTheme.font-body; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.busy ? Tr.t("status.checking") : Tr.t("action.test_auth");
                                kind: ButtonKind.filled;
                                enabled: root.can-test;
                                clicked => { root.current_frame_auth_requested(); }
                            }
                        }
                    }
                }
                Group {
                    title: Tr.t("onboarding.title");
                    Row {
                        title: Tr.t("onboarding.service");
                        subtitle: root.step-service ? Tr.t("onboarding.service_ready") : Tr.t("onboarding.service_action");
                        if root.next-step == 1: Button { text: Tr.t("action.review"); clicked => { root.current_page = 4; } }
                        Check { done: root.step-service; number: "1"; }
                    }
                    Row {
                        title: Tr.t("onboarding.hardware");
                        subtitle: root.step-hardware ? Tr.t("onboarding.hardware_ready") : Tr.t("onboarding.hardware_action");
                        if root.next-step == 2: Button { text: Tr.t("action.review"); clicked => { root.current_page = 4; } }
                        Check { done: root.step-hardware; number: "2"; }
                    }
                    Row {
                        title: Tr.t("onboarding.enrollment");
                        subtitle: root.step-enroll ? Tr.t("onboarding.enrollment_ready") : Tr.t("onboarding.enrollment_action");
                        if root.next-step == 3: Button { text: Tr.t("action.enroll_face"); clicked => { root.current_page = 1; } }
                        Check { done: root.step-enroll; number: "3"; }
                    }
                    Row {
                        title: Tr.t("onboarding.desktop_test");
                        subtitle: root.step-test ? Tr.t("onboarding.desktop_test_ready") : Tr.t("onboarding.desktop_test_action");
                        if root.next-step == 4: Button {
                            text: Tr.t("action.test_auth");
                            enabled: root.can-test;
                            clicked => { root.current_frame_auth_requested(); }
                        }
                        Check { done: root.step-test; number: "4"; }
                    }
                    if !root.platform_windows: Row {
                        title: Tr.t("onboarding.pam");
                        subtitle: root.step-pam
                            ? Tr.tv("onboarding.pam_ready", root.pam_service)
                            : Tr.t("onboarding.pam_action");
                        if root.next-step == 5: Button { text: Tr.t("onboarding.pam_go"); clicked => { root.current_page = 2; } }
                        Check { done: root.step-pam; number: "5"; }
                    }
                }
                Group {
                    title: Tr.t("overview.system");
                    Row {
                        title: Tr.t("diagnostics.auth_service");
                        Status {
                            text: root.service_available ? Tr.t("status.online") : Tr.t("status.offline");
                            tone: root.service_available ? Tone.ok : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("diagnostics.storage");
                        Status {
                            text: root.storage_protection_index == 2 ? Tr.t("diagnostics.storage_tpm")
                                : root.storage_protection_index == 1 ? Tr.t("diagnostics.storage_host")
                                : root.storage_protection_index == 3 ? Tr.t("status.unknown")
                                : Tr.t("status.unavailable");
                            tone: root.storage_protection_index == 2 ? Tone.ok
                                : root.storage_protection_index == 1 ? Tone.warn : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("diagnostics.recognizer");
                        Status {
                            text: root.seetaface_available ? Tr.t("status.ready") : Tr.t("status.unavailable");
                            tone: root.seetaface_available ? Tone.ok : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("settings.camera");
                        Status {
                            text: root.camera-summary;
                            tone: root.camera_count > 0 ? Tone.ok : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("settings.liveness_short");
                        Status {
                            text: root.liveness_enabled ? Tr.t("status.on") : Tr.t("status.off");
                            tone: root.liveness_enabled ? Tone.ok : Tone.idle;
                        }
                    }
                    Row {
                        title: Tr.t("overview.last_check");
                        subtitle: root.activity_detail == "" ? root.activity_title : root.activity_title + " · " + root.activity_detail;
                        Status {
                            text: root.busy ? Tr.t("status.working")
                                : root.activity_tone == "good" ? Tr.t("status.passed")
                                : root.activity_tone == "bad" ? Tr.t("status.failed") : Tr.t("status.idle");
                            tone: root.busy ? Tone.warn
                                : root.activity_tone == "good" ? Tone.ok
                                : root.activity_tone == "bad" ? Tone.danger : Tone.idle;
                        }
                    }
                }
            }

            if root.current_page == 1: Page {
                content-limit: UiTheme.content-wide;
                PageHeader {
                    title: Tr.t("nav.faces");
                    subtitle: Tr.tv("enrollment.manage_for", root.username);
                }
                if root.platform_windows: Group {
                    title: Tr.t("account.credential_title");
                    hint: Tr.t("account.credential_detail");
                    Row {
                        title: Tr.t("account.windows_password");
                        subtitle: root.account_credential_configured
                            ? Tr.t("account.credential_configured") : Tr.t("account.credential_missing");
                        TextField {
                            width: UiTheme.field-width;
                            accessible-label: Tr.t("account.windows_password");
                            text <=> root.account_password_text;
                            input-type: InputType.password;
                            enabled: !root.busy;
                        }
                        Button {
                            text: root.account_credential_configured
                                ? Tr.t("account.update_credential") : Tr.t("account.set_credential");
                            kind: root.account_credential_configured ? ButtonKind.tonal : ButtonKind.filled;
                            enabled: !root.busy && root.account_password_text != "" && root.service_available;
                            clicked => { root.configure_account_credential_requested(root.account_password_text); }
                        }
                    }
                }

                if !root.compact-layout: HorizontalLayout {
                    spacing: UiTheme.s5;
                    PreviewFrame {
                        image: root.preview_image;
                        box-x: root.face_box_x;
                        box-y: root.face_box_y;
                        box-w: root.face_box_w;
                        box-h: root.face_box_h;
                        box-visible: root.face_box_visible;
                        source-width: root.preview_source_width;
                        source-height: root.preview_source_height;
                        status-text: root.preview_status_text;
                        height-limit: root.height - UiTheme.preview-reserve;
                    }
                    CaptureControls {
                        width: UiTheme.preview-side;
                        busy: root.busy;
                        camera-available: root.camera_count > 0;
                        can-capture: root.auth-ready && (!root.platform_windows || root.account_credential_configured);
                        camera-summary: root.camera-summary;
                        activity-detail: root.activity_detail;
                        error-text: root.preview_error_text;
                        label <=> root.enroll_label_text;
                        start => { root.start_preview_requested(); }
                        stop => { root.stop_preview_requested(); }
                        capture(label) => { root.enroll_current_frame_requested(label); }
                    }
                }
                if root.compact-layout: VerticalLayout {
                    spacing: UiTheme.s5;
                    PreviewFrame {
                        image: root.preview_image;
                        box-x: root.face_box_x;
                        box-y: root.face_box_y;
                        box-w: root.face_box_w;
                        box-h: root.face_box_h;
                        box-visible: root.face_box_visible;
                        source-width: root.preview_source_width;
                        source-height: root.preview_source_height;
                        status-text: root.preview_status_text;
                        height-limit: root.height - UiTheme.preview-reserve;
                    }
                    CaptureControls {
                        busy: root.busy;
                        camera-available: root.camera_count > 0;
                        can-capture: root.auth-ready && (!root.platform_windows || root.account_credential_configured);
                        camera-summary: root.camera-summary;
                        activity-detail: root.activity_detail;
                        error-text: root.preview_error_text;
                        label <=> root.enroll_label_text;
                        start => { root.start_preview_requested(); }
                        stop => { root.stop_preview_requested(); }
                        capture(label) => { root.enroll_current_frame_requested(label); }
                    }
                }

                Group {
                    title: Tr.t("enrollment.enrolled_samples");
                    hint: root.profiles.length == 0 ? "" : root.profiles.length == 1
                        ? Tr.t("enrollment.one_sample") : Tr.tv("enrollment.sample_count", root.profiles.length);
                    if root.profiles.length == 0: Row { title: Tr.t("enrollment.empty"); }
                    for profile in root.profiles: Row {
                        title: profile.label;
                        subtitle: Tr.tv("enrollment.enrolled_at", profile.enrolled_at);
                        Button {
                            text: Tr.t("action.remove");
                            kind: ButtonKind.danger;
                            enabled: !root.busy;
                            clicked => { root.delete_profile_requested(profile.id); }
                        }
                    }
                }
            }

            if root.current_page == 2 && !root.platform_windows: Page {
                PageHeader {
                    title: Tr.t("nav.login");
                    subtitle: Tr.t("login.subtitle");
                }
                SystemSetupGroup {
                    helper-available: root.deployment_helper_available;
                    installer-available: root.deployment_installer_available;
                    runtime-ready: root.runtime-ready;
                    busy: root.busy;
                    install-helper => { root.install_deployment_helper_requested(); }
                    initialize => { root.initialize_system_deployment_requested(); }
                }
                KeyringGroup {
                    enrolled: root.authtok_enrolled;
                    status-known: root.authtok_status_known;
                    unavailable-reason: root.wallet_use_reason(root.service_available, root.authtok_status_known,
                        root.profiles.length > 0, root.storage_protection_index == 2, root.sealed_login_deployed);
                    management-available: root.service_available && root.deployment_helper_available;
                    busy: root.busy;
                    password <=> root.wallet_password_text;
                    operation-status: root.wallet_operation_status;
                    save-requested(password) => { root.save_wallet_password_requested(password); }
                    clear-requested => { root.clear_wallet_password_requested(); }
                }
                TargetGroups {
                    targets: root.deployment_targets;
                    login-targets: root.login_targets;
                    lock-targets: root.lock_targets;
                    privilege-targets: root.privilege_targets;
                    helper-available: root.deployment_helper_available;
                    busy: root.busy;
                    windows: false;
                    operation-status: root.deployment_operation_status;
                    configure-requested(target, source) => { root.configure_desktop_target_requested(target, source); }
                    rollback-requested(target) => { root.rollback_desktop_target_requested(target); }
                }
            }

            if root.current_page == 3: Page {
                PageHeader {
                    title: Tr.t("nav.settings");
                    subtitle: Tr.t("settings.subtitle");
                }
                Group {
                    title: Tr.t("settings.camera");
                    hint: Tr.t("settings.camera_detail");
                    Row {
                        title: Tr.t("settings.camera_device");
                        Dropdown { accessible-label: Tr.t("settings.camera_device"); width: UiTheme.field-width * 1.5; model: root.camera_options; current-index <=> root.selected_camera; }
                    }
                    Row {
                        title: Tr.t("settings.preview_fps");
                        Stepper { accessible-label: Tr.t("settings.preview_fps"); minimum: 1; maximum: 60; value <=> root.preview_fps; }
                    }
                }
                Group {
                    title: Tr.t("settings.appearance");
                    hint: Tr.t("settings.appearance_detail");
                    Row {
                        title: Tr.t("settings.language");
                        Dropdown {
                            width: UiTheme.field-width * 1.5;
                            accessible-label: Tr.t("settings.language");
                            model: root.language_names;
                            current-index <=> root.language_index;
                            selected(_) => {
                                root.activity_title = Tr.t("activity.not_checked");
                                root.activity_detail = "";
                                root.settings_status = Tr.t("settings.saved");
                                root.language_selected(root.language_index);
                            }
                        }
                    }
                    Row {
                        title: Tr.t("settings.theme_mode");
                        SegmentedSelector {
                            options: [Tr.t("settings.theme_system"), Tr.t("settings.theme_light"), Tr.t("settings.theme_dark")];
                            current-index <=> root.theme_mode_index;
                            selected(index) => { root.theme_mode_selected(index); }
                        }
                    }
                    Row {
                        title: Tr.t("settings.window_controls");
                        SegmentedSelector {
                            options: [Tr.t("settings.window_controls_auto"), Tr.t("settings.window_controls_show"), Tr.t("settings.window_controls_hide")];
                            current-index <=> root.window_controls_index;
                            selected(index) => { root.window_controls_selected(index); }
                        }
                    }
                }
                Group {
                    title: Tr.t("settings.recognition_policy");
                    hint: Tr.t("settings.policy_detail");
                    Row {
                        title: Tr.t("settings.recognition_threshold");
                        ValueSlider { width: UiTheme.slider-width; minimum: 0.35; maximum: 0.95; value <=> root.recognition_threshold; }
                        Badge { text: Math.round(root.recognition_threshold * 100) + "%"; }
                    }
                    Row {
                        title: Tr.t("settings.liveness_enabled");
                        Toggle {
                            on: root.liveness_enabled;
                            toggled(value) => {
                                root.liveness_enabled = value;
                                root.settings_status = Tr.t("settings.unsaved");
                            }
                        }
                    }
                    Row {
                        title: Tr.t("settings.liveness_threshold");
                        ValueSlider { enabled: root.liveness_enabled; width: UiTheme.slider-width; minimum: 0.2; maximum: 0.95; value <=> root.liveness_threshold; }
                        Badge { text: Math.round(root.liveness_threshold * 100) + "%"; }
                    }
                    Row {
                        title: Tr.t("settings.backlight_compensation");
                        subtitle: Tr.t("settings.backlight_compensation_detail");
                        Toggle {
                            on: root.backlight_compensation;
                            toggled(value) => {
                                root.backlight_compensation = value;
                                root.settings_status = Tr.t("settings.unsaved");
                            }
                        }
                    }
                }
                if root.platform_windows: Group {
                    title: Tr.t("settings.recognition_trigger");
                    hint: Tr.t("settings.trigger_detail");
                    Row {
                        title: Tr.t("settings.auto_recognition");
                        Toggle {
                            on: root.recognition_mode == 1;
                            toggled(value) => {
                                root.recognition_mode = value ? 1 : 0;
                                root.settings_status = Tr.t("settings.unsaved");
                            }
                        }
                    }
                    Row {
                        title: Tr.t("settings.auto_delay");
                        subtitle: Tr.t("settings.auto_delay_detail");
                        Stepper { accessible-label: Tr.t("settings.auto_delay"); enabled: root.recognition_mode == 1; minimum: 0; maximum: 60; value <=> root.auto_delay_sec; }
                    }
                    Row {
                        title: Tr.t("settings.retry_delay");
                        subtitle: Tr.t("settings.retry_delay_detail");
                        Stepper { accessible-label: Tr.t("settings.retry_delay"); enabled: root.recognition_mode == 1; minimum: 1; maximum: 60; value <=> root.retry_delay_sec; }
                    }
                    Row {
                        title: Tr.t("settings.auto_timeout");
                        subtitle: Tr.t("settings.timeout_detail");
                        Stepper { accessible-label: Tr.t("settings.auto_timeout"); enabled: root.recognition_mode == 1; minimum: 5; maximum: 600; value <=> root.timeout_sec; }
                    }
                }
                CapturePanel {
                    capture-enabled <=> root.capture_enabled;
                    days <=> root.capture_days;
                    max-count <=> root.capture_max_count;
                    records: root.captures;
                    selected-image: root.capture_selected_image;
                    selected: root.capture_selected;
                    status: root.capture_status;
                    refresh => { root.capture_refresh(); }
                    open(id) => { root.capture_open(id); }
                    close => { root.capture_selected = false; }
                    remove(id) => { root.capture_delete(id); }
                    remove-all => { root.capture_delete_all(); }
                }
                HorizontalLayout {
                    spacing: UiTheme.s4;
                    Text {
                        text: root.settings_status;
                        color: UiTheme.text-dim;
                        font-size: UiTheme.font-small;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    Button {
                        text: Tr.t("action.save_settings");
                        kind: ButtonKind.filled;
                        enabled: !root.busy;
                        clicked => {
                            root.save_settings_requested(
                                root.selected_camera,
                                root.recognition_threshold,
                                root.liveness_enabled,
                                root.liveness_threshold,
                                root.backlight_compensation,
                                root.preview_fps,
                                root.recognition_mode,
                                root.auto_delay_sec,
                                root.retry_delay_sec,
                                root.timeout_sec);
                        }
                    }
                }
            }

            if root.current_page == 4: Page {
                PageHeader {
                    title: Tr.t("nav.diagnostics");
                    subtitle: Tr.t("diagnostics.subtitle");
                }
                if root.platform_windows: SystemSetupGroup {
                    helper-available: root.deployment_helper_available;
                    installer-available: root.deployment_installer_available;
                    runtime-ready: root.runtime-ready;
                    busy: root.busy;
                    install-helper => { root.install_deployment_helper_requested(); }
                    initialize => { root.initialize_system_deployment_requested(); }
                }
                if root.platform_windows: TargetGroups {
                    targets: root.deployment_targets;
                    login-targets: root.login_targets;
                    lock-targets: root.lock_targets;
                    privilege-targets: root.privilege_targets;
                    helper-available: root.deployment_helper_available;
                    busy: root.busy;
                    windows: true;
                    operation-status: root.deployment_operation_status;
                    configure-requested(target, source) => { root.configure_desktop_target_requested(target, source); }
                    rollback-requested(target) => { root.rollback_desktop_target_requested(target); }
                }
                ModelsGroup {
                    present: root.models_present;
                    downloading: root.models_downloading;
                    progress: root.models_progress;
                    status-text: root.models_status_text;
                    download(accelerated, prefix) => { root.models_download_requested(accelerated, prefix); }
                }
                Group {
                    title: Tr.t("diagnostics.runtime");
                    hint: root.core_version;
                    Row {
                        title: Tr.t("diagnostics.auth_service");
                        subtitle: root.service_available ? Tr.t("diagnostics.service_ready_detail") : Tr.t("diagnostics.service_action");
                        Status {
                            text: root.service_available ? Tr.t("status.online") : Tr.t("status.offline");
                            tone: root.service_available ? Tone.ok : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("diagnostics.storage");
                        subtitle: root.storage-ready ? Tr.t("diagnostics.storage_ready_detail") : Tr.t("diagnostics.storage_action");
                        Status {
                            text: root.storage_protection_index == 2 ? Tr.t("diagnostics.storage_tpm")
                                : root.storage_protection_index == 1 ? Tr.t("diagnostics.storage_host")
                                : root.storage_protection_index == 3 ? Tr.t("status.unknown")
                                : Tr.t("status.unavailable");
                            tone: root.storage_protection_index == 2 ? Tone.ok
                                : root.storage_protection_index == 1 ? Tone.warn : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("diagnostics.recognizer");
                        subtitle: root.seetaface_available ? Tr.t("diagnostics.recognizer_ready_detail") : Tr.t("diagnostics.recognizer_action");
                        Status {
                            text: root.seetaface_available ? Tr.t("status.available") : Tr.t("status.unavailable");
                            tone: root.seetaface_available ? Tone.ok : Tone.danger;
                        }
                    }
                    Row {
                        title: Tr.t("settings.camera");
                        subtitle: root.camera_count == 0 ? Tr.t("diagnostics.camera_action") : Tr.t("diagnostics.camera_ready_detail");
                        Status { text: root.camera-summary; tone: root.camera_count > 0 ? Tone.ok : Tone.danger; }
                    }
                    Row {
                        title: Tr.t("overview.face_samples");
                        subtitle: root.profiles.length == 0 ? Tr.t("diagnostics.profiles_action") : Tr.t("diagnostics.profiles_ready_detail");
                        Status {
                            text: root.profiles.length == 0 ? Tr.t("enrollment.no_samples")
                                : root.profiles.length == 1 ? Tr.t("enrollment.one_sample")
                                : Tr.tv("enrollment.sample_count", root.profiles.length);
                            tone: root.profiles.length > 0 ? Tone.ok : Tone.warn;
                        }
                    }
                    if !root.platform_windows: Row {
                        title: Tr.t("diagnostics.login_pam");
                        subtitle: root.login_pam_configured ? Tr.t("diagnostics.login_pam_ready") : Tr.t("diagnostics.login_pam_action");
                        Status {
                            text: !root.pam_status_known ? Tr.t("status.unknown")
                                : root.login_pam_configured ? Tr.t("status.configured") : Tr.t("status.not_configured");
                            tone: root.login_pam_configured ? Tone.ok : Tone.warn;
                        }
                    }
                    if !root.platform_windows: Row {
                        title: Tr.t("diagnostics.lock_pam");
                        subtitle: root.lock_pam_configured ? Tr.t("diagnostics.lock_pam_ready") : Tr.t("diagnostics.lock_pam_action");
                        Status {
                            text: !root.pam_status_known ? Tr.t("status.unknown")
                                : root.lock_pam_configured ? Tr.t("status.configured") : Tr.t("status.not_configured");
                            tone: root.lock_pam_configured ? Tone.ok : Tone.warn;
                        }
                    }
                    Row {
                        title: Tr.t("diagnostics.refresh_title");
                        Button {
                            text: Tr.t("action.refresh");
                            enabled: !root.busy;
                            clicked => { root.refresh_system_status_requested(); }
                        }
                    }
                }
                Group {
                    title: Tr.t("diagnostics.local_data");
                    hint: Tr.t("diagnostics.local_data_detail");
                    Row { title: Tr.t("diagnostics.configuration"); subtitle: root.config_path_text; }
                    Row { title: Tr.t("overview.face_samples"); subtitle: root.profile_store_path_text; }
                }
                Group {
                    title: Tr.t("diagnostics.bundle_title");
                    hint: Tr.t("diagnostics.bundle_detail");
                    Row {
                        title: Tr.t("diagnostics.export_title");
                        subtitle: root.diagnostics_error != "" ? root.diagnostics_error
                            : root.diagnostics_archive;
                        if root.diagnostics_archive != "": Button {
                            text: Tr.t("diagnostics.show_folder");
                            clicked => { root.show_diagnostics_requested(); }
                        }
                        Button {
                            text: root.diagnostics_exporting ? Tr.t("diagnostics.exporting") : Tr.t("diagnostics.export");
                            kind: ButtonKind.filled;
                            enabled: !root.diagnostics_exporting;
                            clicked => { root.export_diagnostics_requested(); }
                        }
                    }
                }
                if root.diagnostics_error == "" && root.diagnostics_system_unavailable != "": Note {
                    text: Tr.t("diagnostics.system_unavailable") + root.diagnostics_system_unavailable;
                    tone: Tone.warn;
                }
                if !root.platform_windows: Group {
                    title: Tr.t("diagnostics.desktop_auth_check");
                    hint: Tr.t("diagnostics.desktop_auth_detail");
                    Row {
                        title: Tr.t("diagnostics.desktop_auth_run");
                        Button {
                            text: root.busy ? Tr.t("status.checking") : Tr.t("action.run_check");
                            kind: ButtonKind.filled;
                            enabled: root.can-test;
                            clicked => { root.current_frame_auth_requested(); }
                        }
                    }
                }
            }

            if root.current_page == 5: Page {
                AboutContent {
                    app-version: root.app_version;
                    contributors: root.contributors;
                    components: root.open_source_components;
                    license-names: root.license_names;
                    license-index <=> root.license_index;
                    license-text: root.license_text;
                    link-status: root.about_link_status;
                    license-selected(index) => { root.license_selected(index); }
                    project-link-requested(index) => { root.project_link_requested(index); }
                    contributor-link-requested(index) => { root.contributor_link_requested(index); }
                }
            }
        }
    }
}
