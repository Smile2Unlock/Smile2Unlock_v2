import { UiTheme } from "theme.slint";
import { Tr } from "i18n.slint";
import { Button, ButtonKind, Group, Row, Toggle } from "components.slint";
import { Stepper } from "inputs.slint";

export struct CaptureRow { id: string, time: string, reason: string, thumbnail: image, ratio: float }

// Opt-in encrypted capture of failed unlock attempts (settings page section).
export component CapturePanel inherits VerticalLayout {
    in-out property <bool> capture-enabled: false;
    in-out property <int> days: 7;
    in-out property <int> max-count: 50;
    in property <[CaptureRow]> records;
    in property <image> selected-image;
    in property <bool> selected: false;
    in property <string> status;
    callback refresh();
    callback open(string);
    callback close();
    callback remove(string);
    callback remove-all();

    spacing: UiTheme.s6;

    Group {
        title: Tr.t("capture.title");
        hint: Tr.tv("capture.privacy", root.days);
        Row {
            title: Tr.t("capture.enable");
            Toggle {
                on: root.capture-enabled;
                toggled(value) => { root.capture-enabled = value; }
            }
        }
        Row {
            title: Tr.t("capture.days");
            Stepper { accessible-label: Tr.t("capture.days"); value <=> root.days; minimum: 1; maximum: 90; }
        }
        Row {
            title: Tr.t("capture.count");
            Stepper { accessible-label: Tr.t("capture.count"); value <=> root.max-count; minimum: 1; maximum: 200; }
        }
    }

    Group {
        title: Tr.t("capture.photos");
        hint: root.status;
        Row {
            title: root.records.length == 0
                ? Tr.t("capture.empty")
                : Tr.tv(root.records.length == 1 ? "capture.one" : "capture.many", root.records.length);
            Button { text: Tr.t("capture.refresh"); kind: ButtonKind.tonal; clicked => { root.refresh(); } }
            Button {
                text: Tr.t("capture.delete_all");
                kind: ButtonKind.danger;
                enabled: root.records.length > 0;
                clicked => { root.remove-all(); }
            }
        }
        for record in root.records: Rectangle {
            VerticalLayout {
                Rectangle { height: UiTheme.hairline; background: UiTheme.divider; }
                HorizontalLayout {
                    padding: UiTheme.s4;
                    padding-left: UiTheme.s5;
                    padding-right: UiTheme.s5;
                    spacing: UiTheme.s4;
                    Rectangle {
                        width: UiTheme.thumbnail;
                        height: self.width * record.ratio;
                        border-radius: UiTheme.radius-control;
                        clip: true;
                        Image { width: parent.width; height: parent.height; source: record.thumbnail; image-fit: contain; }
                        TouchArea { clicked => { root.open(record.id); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: UiTheme.s1;
                        Text { text: record.time; color: UiTheme.text; font-size: UiTheme.font-row-title; font-weight: UiTheme.weight-bold; wrap: word-wrap; }
                        Text { text: Tr.t("capture." + record.reason); color: UiTheme.text-dim; font-size: UiTheme.font-small; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: UiTheme.s3;
                            Button { text: Tr.t("capture.open"); kind: ButtonKind.tonal; clicked => { root.open(record.id); } }
                            Button { text: Tr.t("capture.delete"); kind: ButtonKind.danger; clicked => { root.remove(record.id); } }
                        }
                    }
                }
            }
        }
    }

    if root.selected: Group {
        title: Tr.t("capture.preview");
        Rectangle {
            VerticalLayout {
                padding: UiTheme.s5;
                spacing: UiTheme.s4;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: root.selected-image;
                        image-fit: contain;
                        horizontal-stretch: 0;
                        min-width: 0;
                        max-width: root.selected-image.width * UiTheme.pixel * 2;
                        preferred-width: root.selected-image.width * UiTheme.pixel;
                        height: self.width * root.selected-image.height / max(1, root.selected-image.width);
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button { text: Tr.t("capture.close"); kind: ButtonKind.tonal; clicked => { root.close(); } }
                }
            }
        }
    }
}
