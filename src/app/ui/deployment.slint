import { Switch } from "std-widgets.slint";
import { UiTheme } from "theme.slint";
import {
    CenteredActionButton, CenteredStatusPill, SectionTitle, StatusPill,
} from "components.slint";

export struct DeploymentTargetRow {
    id: string,
    service: string,
    effective_path: string,
    role: string,
    state: string,
    password_fallback: bool,
    configured: bool,
    configurable: bool,
    managed: bool,
    wallet_available: bool,
    wallet_enabled: bool,
}

export component DeploymentPanel inherits Rectangle {
    in property <[DeploymentTargetRow]> targets;
    in property <bool> helper_available: false;
    in property <bool> runtime_ready: false;
    in property <bool> busy: false;
    in property <int> language_index: 0;
    in property <string> operation_status: "";

    callback initialize_requested();
    callback configure_requested(string, bool);
    callback rollback_requested(string);
    pure callback translate(string, int) -> string;

    private property <string> pending_target: "";
    private property <string> pending_action: "";

    height: root.targets.length == 0 ? 190px : 142px + root.targets.length * 80px;
    border-radius: 6px;
    border-width: 1px;
    border-color: UiTheme.border;
    background: UiTheme.surface;

    VerticalLayout {
        padding: 20px;
        spacing: 8px;

        HorizontalLayout {
            height: 48px;
            spacing: 12px;
            SectionTitle {
                horizontal-stretch: 1;
                title: root.translate("deployment.title", root.language_index);
                detail: root.helper_available
                    ? root.translate("deployment.helper_ready", root.language_index)
                    : root.translate("deployment.helper_missing", root.language_index);
            }
            if root.runtime_ready: CenteredStatusPill {
                width: 156px;
                label: root.translate("status.ready", root.language_index);
                tone: "good";
            }
            if !root.runtime_ready: CenteredActionButton {
                width: 156px;
                label: root.helper_available
                    ? root.translate("deployment.initialize", root.language_index)
                    : root.translate("deployment.install_helper", root.language_index);
                primary: root.helper_available;
                enabled: root.helper_available && !root.busy;
                activated => { root.initialize_requested(); }
            }
        }

        if root.targets.length == 0: Rectangle {
            height: 50px;
            background: UiTheme.surface-subtle;
            border-radius: 4px;
            Text {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                text: root.translate("deployment.no_targets", root.language_index);
                color: UiTheme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        for target in root.targets: Rectangle {
            height: 72px;
            background: transparent;
            property <bool> wallet_selected: target.wallet_enabled;

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    width: 176px;
                    spacing: 4px;
                    Text {
                        text: target.service;
                        color: UiTheme.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: target.role == "login"
                            ? root.translate("deployment.role_login", root.language_index)
                            : target.role == "lock"
                                ? root.translate("deployment.role_lock", root.language_index)
                                : root.translate("deployment.role_both", root.language_index);
                        color: UiTheme.text-tertiary;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: target.effective_path;
                        color: UiTheme.text-secondary;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: target.password_fallback
                            ? root.translate("deployment.password_fallback_ready", root.language_index)
                            : root.translate("deployment.password_fallback_unknown", root.language_index);
                        color: target.password_fallback ? UiTheme.success-text : UiTheme.warning-text;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                StatusPill {
                    width: 100px;
                    label: target.state == "supported"
                        ? root.translate("deployment.state_supported", root.language_index)
                        : target.state == "managed"
                            ? root.translate("deployment.state_managed", root.language_index)
                            : target.state == "external"
                                ? root.translate("deployment.state_external", root.language_index)
                                : target.state == "conflict"
                                    ? root.translate("deployment.state_conflict", root.language_index)
                                    : root.translate("deployment.state_unsupported", root.language_index);
                    tone: target.configured ? "good"
                        : target.configurable ? "neutral"
                        : target.state == "conflict" ? "bad" : "warn";
                }

                if target.wallet_available: Switch {
                    width: 118px;
                    text: root.translate("deployment.wallet", root.language_index);
                    checked <=> wallet_selected;
                    enabled: target.wallet_available && !target.managed && !root.busy;
                }
                if !target.wallet_available: Text {
                    width: 118px;
                    text: target.wallet_enabled
                        ? root.translate("status.configured", root.language_index)
                        : root.translate("deployment.wallet_unavailable", root.language_index);
                    color: UiTheme.disabled-text;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if target.managed || target.configurable: CenteredActionButton {
                    width: 112px;
                    label: !root.helper_available
                        ? root.translate("deployment.install_helper", root.language_index)
                        : root.pending_target == target.id
                            ? target.managed
                                ? root.translate("deployment.confirm_rollback", root.language_index)
                                : root.translate("deployment.apply", root.language_index)
                            : target.managed
                                ? root.translate("deployment.review_rollback", root.language_index)
                                : root.translate("deployment.review", root.language_index);
                    primary: root.pending_target == target.id && !target.managed;
                    danger: target.managed;
                    enabled: root.helper_available && !root.busy
                        && (target.managed || target.configurable);
                    activated => {
                        if (root.pending_target != target.id) {
                            root.pending_target = target.id;
                            root.pending_action = target.managed ? "rollback" : "configure";
                        } else {
                            root.pending_target = "";
                            root.pending_action = "";
                            if (target.managed) {
                                root.rollback_requested(target.id);
                            } else {
                                root.configure_requested(target.id, wallet_selected);
                            }
                        }
                    }
                }
                if !target.managed && !target.configurable: Text {
                    width: 112px;
                    text: target.state == "external"
                        ? root.translate("deployment.external_read_only", root.language_index)
                        : root.translate("deployment.not_available", root.language_index);
                    color: UiTheme.text-tertiary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            height: 18px;
            text: root.pending_target != ""
                ? root.pending_action == "rollback"
                    ? root.translate("deployment.review_rollback_detail", root.language_index)
                    : root.translate("deployment.review_detail", root.language_index)
                : root.operation_status;
            color: UiTheme.text-secondary;
            font-size: 11px;
            overflow: elide;
        }
    }
}
