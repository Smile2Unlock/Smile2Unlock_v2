import { UiTheme } from "theme.slint";
import { Tr } from "i18n.slint";
import { Button, ButtonKind, Chevron, Group, Note, ProgressBar, Row, Status, Tone, Toggle } from "components.slint";
import { TextField } from "inputs.slint";

export struct DeploymentTargetRow {
    id: string,
    service: string,
    effective_path: string,
    role: string,
    state: string,
    password_fallback: bool,
    configured: bool,
    configurable: bool,
    managed: bool,
    wallet_available: bool,
    wallet_unavailable_reason: string,
    sealed_available: bool,
    sealed_unavailable_reason: string,
    authtok_source: int,
}

// Keyring source indices shared with the C++ side (wallet::sources).
// 0 = off, 1 = kernel keyring (legacy, no longer offered), 2 = saved password.
component TargetItem inherits VerticalLayout {
    in property <DeploymentTargetRow> target;
    in property <bool> helper-available;
    in property <bool> busy;
    in property <bool> windows;
    // "", "configure" or "rollback" when this target awaits confirmation.
    in property <string> pending-action;
    callback begin(string);
    callback cancel();
    callback confirm(string, int);

    property <bool> expanded;
    property <int> selected: target.authtok-source;
    property <bool> changed: target.managed && selected != target.authtok-source;
    property <bool> login-capable: target.role == "login" || target.role == "login-and-lock";
    property <bool> actionable: helper-available && target.configurable;
    property <bool> repair: target.id == "auth-service";
    property <bool> details: windows || expanded || pending-action != "" || changed;
    property <bool> show-turn-on: actionable && pending-action != "configure"
        && (repair || !target.managed);
    property <bool> keyring-row: !windows && login-capable && (target.managed || target.configurable);
    property <string> path-line: target.effective-path == "" ? "" : target.effective-path;

    changed target => { self.selected = target.authtok-source; }

    Row {
        title: Tr.t("target." + target.id);
        subtitle: target.id == "credential-provider"
            ? (target.configured ? Tr.t("deployment.cp_registered") : Tr.t("deployment.cp_incomplete"))
            : target.id == "auth-service"
                ? (target.configured ? Tr.t("deployment.service_running")
                    : target.state == "conflict" ? Tr.t("deployment.service_legacy_path")
                    : target.state == "supported" ? Tr.t("deployment.service_stopped")
                    : Tr.t("deployment.service_missing"))
                : target.managed
                    ? (target.authtok-source == 0 ? Tr.t("target.face_on")
                        : target.authtok-source == 1 ? Tr.t("target.face_kernel") : Tr.t("target.face_keyring"))
                    : target.state == "external" ? Tr.t("target.external")
                    : target.state == "conflict" ? Tr.t("target.conflict")
                    : target.state == "unsupported" ? Tr.t("target.unsupported")
                    : Tr.t("target.off");
        interactive: !root.windows;
        clicked => { root.expanded = !root.expanded; }
        if root.show-turn-on: Button {
            text: root.repair ? Tr.t("deployment.repair_service") : Tr.t("target.turn_on");
            kind: ButtonKind.tonal;
            enabled: !root.busy;
            clicked => {
                root.expanded = true;
                root.begin("configure");
            }
        }
        if (target.managed && !root.repair) || (root.repair && target.configured): Status {
            text: Tr.t("status.on");
            tone: Tone.ok;
        }
        if !target.managed && target.state == "external": Status { text: Tr.t("status.manual"); tone: Tone.idle; }
        if target.state == "conflict": Status { text: Tr.t("status.conflict"); tone: Tone.warn; }
        if target.state == "unsupported": Status { text: Tr.t("status.unavailable"); tone: Tone.idle; }
        if !root.helper-available && (target.managed || target.configurable): Status {
            text: Tr.t("deployment.helper_required");
            tone: Tone.warn;
        }
        if !root.windows: VerticalLayout {
            alignment: center;
            Chevron { open: root.details; }
        }
    }

    if root.details && root.keyring-row: Row {
        nested: true;
        title: Tr.t("target.keyring");
        subtitle: root.selected == 1 ? Tr.t("target.keyring_kernel")
            : root.selected == 0 && !target.sealed-available ? Tr.t(target.sealed-unavailable-reason)
            : Tr.t("target.keyring_hint");
        Toggle {
            on: root.selected != 0;
            enabled: !root.busy && root.actionable && (root.selected != 0 || target.sealed-available);
            toggled(value) => {
                root.selected = value ? 2 : 0;
                root.cancel();
            }
        }
    }

    if root.details && root.changed: Row {
        nested: true;
        title: Tr.t("target.apply_title");
        subtitle: Tr.t("target.apply_detail");
        Button {
            text: Tr.t("action.cancel");
            kind: ButtonKind.text;
            clicked => { root.selected = target.authtok-source; }
        }
        Button {
            text: Tr.t("deployment.apply");
            kind: ButtonKind.filled;
            enabled: !root.busy && root.actionable;
            clicked => { root.confirm("configure", root.selected); }
        }
    }

    if root.pending-action == "configure": Row {
        nested: true;
        title: root.repair ? Tr.t("target.review_repair") : Tr.t("target.review_on");
        subtitle: root.repair ? Tr.t("deployment.review_detail") : Tr.tv("target.review_on_detail", target.effective-path);
        Button { text: Tr.t("action.cancel"); kind: ButtonKind.text; clicked => { root.cancel(); } }
        Button {
            text: root.repair ? Tr.t("deployment.confirm_repair") : Tr.t("target.confirm_on");
            kind: ButtonKind.filled;
            enabled: !root.busy;
            clicked => { root.confirm("configure", root.selected); }
        }
    }

    if root.details && root.path-line != "": Row {
        nested: true;
        title: Tr.t("target.file");
        subtitle: root.path-line + (target.password-fallback ? " · " + Tr.t("target.fallback_kept") : "");
        if root.helper-available && target.managed && !root.repair && root.pending-action != "rollback": Button {
            text: Tr.t("target.turn_off");
            kind: ButtonKind.danger;
            enabled: !root.busy;
            clicked => { root.begin("rollback"); }
        }
    }

    if root.pending-action == "rollback": Row {
        nested: true;
        title: Tr.t("target.review_off");
        subtitle: Tr.t("deployment.review_rollback_detail");
        Button { text: Tr.t("action.cancel"); kind: ButtonKind.text; clicked => { root.cancel(); } }
        Button {
            text: Tr.t("target.confirm_off");
            kind: ButtonKind.danger;
            enabled: !root.busy;
            clicked => { root.confirm("rollback", 0); }
        }
    }
}

// Owns the single pending review/confirm so only one entry awaits a decision.
export component TargetGroups inherits VerticalLayout {
    in property <[DeploymentTargetRow]> targets;
    in property <[DeploymentTargetRow]> login-targets;
    in property <[DeploymentTargetRow]> lock-targets;
    in property <[DeploymentTargetRow]> privilege-targets;
    in property <bool> helper-available;
    in property <bool> busy;
    in property <bool> windows;
    in property <string> operation-status;
    callback configure-requested(string, int);
    callback rollback-requested(string);

    property <string> pending-target;
    property <string> pending-action;

    spacing: UiTheme.s6;

    if root.windows && root.targets.length > 0: Group {
        title: Tr.t("deployment.windows_title");
        for target in root.targets: TargetItem {
            target: target;
            helper-available: root.helper-available;
            busy: root.busy;
            windows: true;
            pending-action: root.pending-target == target.id ? root.pending-action : "";
            begin(action) => { root.pending-target = target.id; root.pending-action = action; }
            cancel() => { root.pending-target = ""; root.pending-action = ""; }
            confirm(action, source) => { root.finish(target.id, action, source); }
        }
    }

    if !root.windows: VerticalLayout {
        spacing: UiTheme.s6;
        if root.targets.length == 0: Group {
            Row { title: Tr.t("deployment.no_targets"); }
        }
        if root.login-targets.length > 0: Group {
            title: Tr.t("deployment.login_group");
            hint: Tr.t("deployment.login_hint");
            for target in root.login-targets: TargetItem {
                target: target;
                helper-available: root.helper-available;
                busy: root.busy;
                windows: false;
                pending-action: root.pending-target == target.id ? root.pending-action : "";
                begin(action) => { root.pending-target = target.id; root.pending-action = action; }
                cancel() => { root.pending-target = ""; root.pending-action = ""; }
                confirm(action, source) => { root.finish(target.id, action, source); }
            }
        }
        if root.lock-targets.length > 0: Group {
            title: Tr.t("deployment.lock_group");
            for target in root.lock-targets: TargetItem {
                target: target;
                helper-available: root.helper-available;
                busy: root.busy;
                windows: false;
                pending-action: root.pending-target == target.id ? root.pending-action : "";
                begin(action) => { root.pending-target = target.id; root.pending-action = action; }
                cancel() => { root.pending-target = ""; root.pending-action = ""; }
                confirm(action, source) => { root.finish(target.id, action, source); }
            }
        }
        if root.privilege-targets.length > 0: Group {
            title: Tr.t("deployment.privilege_group");
            hint: Tr.t("deployment.privilege_hint");
            for target in root.privilege-targets: TargetItem {
                target: target;
                helper-available: root.helper-available;
                busy: root.busy;
                windows: false;
                pending-action: root.pending-target == target.id ? root.pending-action : "";
                begin(action) => { root.pending-target = target.id; root.pending-action = action; }
                cancel() => { root.pending-target = ""; root.pending-action = ""; }
                confirm(action, source) => { root.finish(target.id, action, source); }
            }
        }
    }

    if root.operation-status != "": Note { text: root.operation-status; }

    function finish(target: string, action: string, source: int) {
        root.pending-target = "";
        root.pending-action = "";
        if (action == "rollback") {
            root.rollback-requested(target);
        } else {
            root.configure-requested(target, source);
        }
    }
}

// Shown only while the helper or the runtime still needs setting up.
export component SystemSetupGroup inherits VerticalLayout {
    in property <bool> helper-available;
    in property <bool> installer-available;
    in property <bool> runtime-ready;
    in property <bool> busy;
    callback install-helper();
    callback initialize();

    if !root.helper-available || !root.runtime-ready: Group {
        title: Tr.t("deployment.setup_title");
        Row {
            title: Tr.t("deployment.helper_title");
            subtitle: root.helper-available ? Tr.t("deployment.helper_ready")
                : root.installer-available ? Tr.t("deployment.helper_installable")
                : Tr.t("deployment.helper_missing");
            if root.helper-available: Status { text: Tr.t("status.ready"); tone: Tone.ok; }
            if !root.helper-available && root.installer-available: Button {
                text: Tr.t("deployment.install_helper");
                kind: ButtonKind.filled;
                enabled: !root.busy;
                clicked => { root.install-helper(); }
            }
            if !root.helper-available && !root.installer-available: Status {
                text: Tr.t("deployment.helper_required");
                tone: Tone.warn;
            }
        }
        Row {
            title: Tr.t("deployment.runtime_title");
            subtitle: Tr.t("deployment.runtime_detail");
            if root.runtime-ready: Status { text: Tr.t("status.ready"); tone: Tone.ok; }
            if !root.runtime-ready: Button {
                text: Tr.t("deployment.initialize");
                kind: root.helper-available ? ButtonKind.filled : ButtonKind.tonal;
                enabled: !root.busy && root.helper-available;
                clicked => { root.initialize(); }
            }
        }
    }
}

// Face-model download (SeetaFace6), shown while models are missing or downloading.
export component ModelsGroup inherits VerticalLayout {
    in property <bool> present: true;
    in property <bool> downloading: false;
    in property <float> progress: 0;
    in property <string> status-text;
    in-out property <string> mirror: "https://ghproxy.com/";
    callback download(bool, string);

    if !root.present || root.downloading: Group {
        title: Tr.t("models.title");
        Row {
            title: Tr.t("models.recognition");
            subtitle: root.present ? Tr.t("models.ok") : Tr.t("models.missing");
            Status {
                text: root.present ? Tr.t("status.ready") : Tr.t("status.action_required");
                tone: root.present ? Tone.ok : Tone.danger;
            }
        }
        if !root.downloading: Row {
            title: Tr.t("models.mirror_title");
            subtitle: Tr.t("models.mirror_hint");
            TextField {
                width: UiTheme.field-width * 1.5;
                accessible-label: Tr.t("models.mirror_title");
                text <=> root.mirror;
            }
        }
        if !root.downloading: Row {
            title: Tr.t("models.download");
            Button {
                text: Tr.t("models.download_mirror");
                kind: ButtonKind.tonal;
                clicked => { root.download(true, root.mirror); }
            }
            Button {
                text: Tr.t("models.download_direct");
                kind: ButtonKind.filled;
                clicked => { root.download(false, ""); }
            }
        }
        if root.downloading: Row {
            title: root.status-text;
            ProgressBar {
                width: UiTheme.field-width;
                progress: root.progress;
            }
        }
    }
}
