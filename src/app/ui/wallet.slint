import { UiTheme } from "theme.slint";
import { Tr } from "i18n.slint";
import { Button, ButtonKind, Group, Note, Row, Toggle } from "components.slint";
import { TextField } from "inputs.slint";

// Keyring auto-unlock: one master switch. Turning it on asks for the sign-in
// password inline; turning it off asks for confirmation first. The password is
// cleared from the field as soon as it is submitted or dismissed.
export component KeyringGroup inherits VerticalLayout {
    in property <bool> enrolled;
    in property <bool> status-known;
    // Translation key of the single reason the feature is unavailable, or "".
    in property <string> unavailable-reason;
    in property <bool> management-available;
    in property <bool> busy;
    in property <string> operation-status;
    in-out property <string> password;
    callback save-requested(string);
    callback clear-requested();

    property <bool> entering: false;
    property <bool> confirming-off: false;
    property <bool> usable: status-known && management-available && unavailable-reason == "";
    property <string> blocked-reason: !status-known ? Tr.t("wallet.status_unavailable")
        : !management-available ? Tr.t("wallet.management_required")
        : unavailable-reason != "" ? Tr.t(unavailable-reason) : "";

    changed busy => {
        root.confirming-off = false;
        root.entering = false;
        root.password = "";
    }

    spacing: UiTheme.s2;

    Group {
        title: Tr.t("wallet.title");
        hint: Tr.t("wallet.hint");
        Row {
            title: Tr.t("wallet.toggle");
            subtitle: root.enrolled || root.usable ? Tr.t("wallet.toggle_detail") : root.blocked-reason;
            Toggle {
                on: root.enrolled || root.entering;
                enabled: !root.busy && root.status-known && root.management-available
                    && (root.enrolled || root.usable);
                toggled(value) => {
                    root.password = "";
                    if value {
                        root.confirming-off = false;
                        root.entering = true;
                    } else {
                        root.entering = false;
                        root.confirming-off = root.enrolled;
                    }
                }
            }
        }
        if root.enrolled && !root.entering && !root.confirming-off: Row {
            title: Tr.t("wallet.enrolled");
            subtitle: Tr.t("wallet.enrolled_detail");
            Button {
                text: Tr.t("wallet.update");
                kind: ButtonKind.text;
                enabled: !root.busy && root.usable;
                clicked => { root.entering = true; }
            }
        }
        if root.entering: Row {
            title: Tr.t("wallet.password_label");
            subtitle: Tr.t("wallet.password_detail");
            TextField {
                width: UiTheme.field-width;
                accessible-label: Tr.t("wallet.password_label");
                text <=> root.password;
                input-type: InputType.password;
                enabled: !root.busy && root.usable;
            }
            Button {
                text: Tr.t("action.cancel");
                kind: ButtonKind.text;
                clicked => {
                    root.password = "";
                    root.entering = false;
                }
            }
            Button {
                text: Tr.t("wallet.save");
                kind: ButtonKind.filled;
                enabled: !root.busy && root.usable && root.password != "";
                clicked => {
                    root.save-requested(root.password);
                    root.password = "";
                    root.entering = false;
                }
            }
        }
        if root.confirming-off: Row {
            title: Tr.t("wallet.confirm_title");
            subtitle: Tr.t("wallet.review_off");
            Button {
                text: Tr.t("action.cancel");
                kind: ButtonKind.text;
                clicked => { root.confirming-off = false; }
            }
            Button {
                text: Tr.t("wallet.confirm_off");
                kind: ButtonKind.danger;
                enabled: !root.busy && root.management-available && root.status-known && root.enrolled;
                clicked => {
                    root.confirming-off = false;
                    root.password = "";
                    root.clear-requested();
                }
            }
        }
    }
    if root.operation-status != "": Note { text: root.operation-status; }
}
