import { ComboBox, TextEdit } from "std-widgets.slint";
import { UiTheme } from "theme.slint";
import { Tr } from "i18n.slint";
import { Badge, Button, ButtonKind, Group, Note, PageHeader, Row, Tone } from "components.slint";

export struct ContributorRow { name: string, role: string, }
export struct LicenseSummaryRow { name: string, license: string, }

export component AboutContent inherits VerticalLayout {
    in property <string> app-version;
    in property <[ContributorRow]> contributors;
    in property <[LicenseSummaryRow]> components;
    in property <[string]> license-names;
    in-out property <int> license-index: 0;
    in property <string> license-text;
    in property <string> link-status;
    callback license-selected(int);
    callback project-link-requested(int);
    callback contributor-link-requested(int);

    spacing: UiTheme.s6;

    PageHeader {
        title: Tr.t("nav.about");
        subtitle: Tr.t("about.subtitle");
    }
    Group {
        Rectangle {
            VerticalLayout {
                padding: UiTheme.s5;
                spacing: UiTheme.s3;
                HorizontalLayout {
                    spacing: UiTheme.s3;
                    Text {
                        text: "Smile2Unlock";
                        color: UiTheme.text;
                        font-size: UiTheme.font-hero;
                        font-weight: UiTheme.weight-bold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Badge { text: Tr.t("about.version") + " " + root.app-version; }
                    }
                }
                Text { text: Tr.t("about.description"); color: UiTheme.text-dim; font-size: UiTheme.font-body; wrap: word-wrap; }
                Text { text: Tr.t("about.project_license"); color: UiTheme.text-faint; font-size: UiTheme.font-small; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: UiTheme.s3;
                    alignment: start;
                    Button { text: Tr.t("about.source"); kind: ButtonKind.filled; clicked => { root.project-link-requested(0); } }
                    Button { text: Tr.t("about.issues"); kind: ButtonKind.tonal; clicked => { root.project-link-requested(1); } }
                }
            }
        }
    }
    if root.link-status != "": Note { text: root.link-status; tone: Tone.warn; }

    Group {
        title: Tr.t("about.contributors");
        hint: Tr.t("about.thanks");
        for contributor[index] in root.contributors: Row {
            title: contributor.name;
            subtitle: Tr.t(contributor.role);
            Button { text: Tr.t("about.profile"); kind: ButtonKind.tonal; clicked => { root.contributor-link-requested(index); } }
        }
    }

    Group {
        title: Tr.t("about.open_source");
        hint: Tr.t("about.license_detail");
        for component in root.components: Row {
            title: component.name;
            subtitle: component.license;
        }
    }

    Group {
        title: Tr.t("about.license_texts");
        hint: Tr.t("about.offline");
        Row {
            title: Tr.t("about.license_pick");
            license-selector := ComboBox {
                width: UiTheme.field-width * 1.5;
                model: root.license-names;
                current-index <=> root.license-index;
                selected(_) => { root.license-selected(license-selector.current-index); }
            }
        }
        Rectangle {
            VerticalLayout {
                padding: UiTheme.s4;
                TextEdit {
                    text: root.license-text;
                    read-only: true;
                    height: UiTheme.license-height;
                    font-size: UiTheme.font-small;
                }
            }
        }
    }
}
