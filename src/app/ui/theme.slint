// Theme tokens. Colour roles are filled at runtime from the wallpaper palette
// (DMS / matugen) by su.app.theme + apply_theme(); the defaults below are only
// what shows before the first palette is applied. Every metric derives from
// `base`, the single length literal of the UI.
export global UiTheme {
    in-out property <bool> dark-mode: true;

    // ---- surfaces (depth by tone, not by borders) ----
    in-out property <color> canvas: #131318;
    in-out property <color> sidebar: #1f1f25;
    in-out property <color> group: #1f1f25;
    in-out property <color> group-hover: #29292f;
    in-out property <color> inset: #29292f;
    in-out property <color> outline: #46464f;
    in-out property <color> divider: #2c2c33;

    // ---- text ----
    in-out property <color> text: #e4e1e9;
    in-out property <color> text-dim: #c7c5d0;
    in-out property <color> text-faint: #90909a;

    // ---- accent ----
    in-out property <color> accent: #bbc3ff;
    in-out property <color> on-accent: #232c61;
    in-out property <color> tonal: #3a4379;
    in-out property <color> on-tonal: #dee0ff;
    in-out property <color> nav-selected: #434559;
    in-out property <color> on-nav-selected: #e0e1f9;

    // ---- status ----
    in-out property <color> ok: #8fd6a6;
    in-out property <color> ok-bg: #1d3326;
    in-out property <color> warn: #ecc770;
    in-out property <color> warn-bg: #3a3020;
    in-out property <color> danger: #ffb4ab;
    in-out property <color> danger-bg: #3d1d1b;
    in-out property <color> idle: #90909a;
    in-out property <color> idle-bg: #29292f;

    // ---- camera preview (fixed) ----
    in-out property <color> preview-surface: #101816;
    in-out property <color> preview-overlay: #15201ecc;
    in-out property <color> preview-text: #e8f6f1;
    in-out property <color> face-indicator: #4dd3a7;

    // ---- metrics: everything below derives from `base` ----
    out property <length> base: 14px;
    // One physical image pixel, to size images from their pixel dimensions.
    out property <length> pixel: 1px;
    out property <length> unit: base * 0.29;
    out property <length> s1: unit;
    out property <length> s2: unit * 2;
    out property <length> s3: unit * 3;
    out property <length> s4: unit * 4;
    out property <length> s5: unit * 5;
    out property <length> s6: unit * 6;
    out property <length> s8: unit * 8;
    out property <length> hairline: unit / 4;
    out property <length> stroke: unit / 2;

    out property <length> font-body: base;
    out property <length> font-small: base * 0.86;
    out property <length> font-row-title: base * 1.07;
    out property <length> font-section: base * 0.93;
    out property <length> font-brand: base * 1.23;
    out property <length> font-h1: base * 1.86;
    out property <length> font-hero: base * 1.43;
    out property <length> font-stat: base * 1.7;

    out property <length> radius-group: unit * 3;
    out property <length> radius-control: unit * 2;
    out property <length> radius-small: unit;
    out property <length> content-max: base * 62;
    out property <length> sidebar-width: base * 16;
    out property <length> dot: unit * 2;
    out property <length> avatar: base * 2.6;
    out property <length> check: base * 1.8;
    out property <length> hero-badge: base * 3.7;
    out property <length> field-width: base * 16;
    out property <length> field-narrow: base * 7;
    out property <length> slider-width: base * 14;
    out property <length> toggle-height: base * 1.7;
    out property <length> thumbnail: base * 6;
    out property <length> license-height: base * 24;
    out property <length> preview-height: base * 25;
    out property <length> preview-side: base * 30;
    out property <length> overlay-width: base * 16;
    out property <length> window-width: base * 86;
    out property <length> window-height: base * 56;
    // Below this window width the preview and capture panel stack vertically.
    out property <length> compact-width: base * 66;
}
