#pragma code_page(65001)
#include <windows.h>

#include "su_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SU_VERSION_NUMERIC
 PRODUCTVERSION SU_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "Smile2Unlock 人脸识别解锁"
            VALUE "FileVersion", SU_VERSION_STR
            VALUE "InternalName", "Smile2Unlock"
            VALUE "ProductName", "Smile2Unlock"
            VALUE "ProductVersion", SU_VERSION_STR
            VALUE "OriginalFilename", "Smile2Unlock.exe"
            VALUE "LegalCopyright", "Copyright (c) Smile2Unlock contributors"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Smile2Unlock Face Unlock"
            VALUE "FileVersion", SU_VERSION_STR
            VALUE "InternalName", "Smile2Unlock"
            VALUE "ProductName", "Smile2Unlock"
            VALUE "ProductVersion", SU_VERSION_STR
            VALUE "OriginalFilename", "Smile2Unlock.exe"
            VALUE "LegalCopyright", "Copyright (c) Smile2Unlock contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

// Explorer/window icon until the runtime WM_SETICON applies it.
IDI_APP_ICON ICON "../../assets/icons/Smile2Unlock.ico"
